###############################################################################

print_du_rows() {
	local size path

	while IFS=$'\t' read -r size path; do
		printf "    %s%7s%s  %s\n" "$C_BOLD" "$size" "$C_RESET" "$(short_path "$path")"
	done
}

analyze_section() {
	local title="$1"
	local target="$2"
	local items=()

	[ ! -d "$target" ] && return 0

	items=("$target"/*)
	[ "${#items[@]}" -eq 0 ] && return 0

	heading "$title"
	du -sh "${items[@]}" 2>/dev/null | sort -hr | head -30 | print_du_rows
}

run_analyze() {
	local top=()

	echo
	ui_info "Analyzing biggest space consumers under ~ ..."

	print_disk_space

	analyze_section "~/.var/app" "$HOME/.var/app"
	analyze_section "~/.cache" "$HOME/.cache"
	analyze_section "~/.config" "$HOME/.config"
	analyze_section "~/.local/share" "$HOME/.local/share"

	# Visible + hidden entries, without the "." and ".." pseudo-entries.
	top=("$HOME"/* "$HOME"/.[!.]* "$HOME"/..?*)
	if [ "${#top[@]}" -gt 0 ]; then
		heading "Top items in ~"
		du -sh "${top[@]}" 2>/dev/null | sort -hr | head -40 | print_du_rows
	fi
	echo
}

