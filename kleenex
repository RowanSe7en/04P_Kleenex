	remove_literal_dir_contents "$base/config/Code/DawnWebGPUCache" "Dawn WebGPU cache"
	remove_literal_dir_contents "$base/config/Code/DawnGraphiteCache" "Dawn Graphite cache"
	remove_literal_dir_contents "$base/config/Code/Shared Dictionary/cache" "Shared dictionary cache"

	# Heavy real target on your machine
	remove_literal_dir_contents "$base/config/Code/CachedExtensionVSIXs" "Cached extension VSIXs"

