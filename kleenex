clean_chrome_profile() {
	local profile="$1"

	[ ! -d "$profile" ] && return 0

	# Only the two cache subdirectories of Service Worker/ are touched.
	# Service Worker/ServiceWorkerDatabase (NOT touched) holds the
	# registration metadata for every installed service worker, including
	# every Manifest V3 extension's background service worker. Deleting
	# the whole Service Worker/ folder (as this used to do) wipes that
	# registry and can make extensions look "reset" until reloaded.
	remove_literal_dir_contents "$profile/Service Worker/CacheStorage" "Service Worker cache"
	remove_literal_dir_contents "$profile/Service Worker/ScriptCache" "Service Worker scripts"
	remove_literal_dir_contents "$profile/GPUCache" "GPU cache"
	remove_literal_dir_contents "$profile/DawnWebGPUCache" "Dawn WebGPU cache"
	remove_literal_dir_contents "$profile/DawnGraphiteCache" "Dawn Graphite cache"
	remove_literal_dir_contents "$profile/Code Cache" "Code cache"
	remove_literal_dir_contents "$profile/Cache" "Cache"
	remove_literal_dir_contents "$profile/Application Cache" "Application cache"
	remove_literal_dir_contents "$profile/blob_storage" "Blob storage"
	remove_literal_dir_contents "$profile/Shared Dictionary/cache" "Shared dictionary cache"

	# NOTE: File System/ intentionally NOT cleaned. It backs the
	# sandboxed Filesystem API and syncable filesystem, which extensions
	# and web apps can use to persist real data (not just cache); Chrome
	# itself never clears it proactively, so this script doesn't either.

	# NOTE: Extension State/, Local Extension Settings/, and Extension
	# Scripts/ (per profile, including every Profile */ variant) are
	# NEVER touched by this script. They hold real extension settings,
	# local storage, and content-script bookkeeping — not cache.
}

