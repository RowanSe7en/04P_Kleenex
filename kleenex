clean_general() {
	CURRENT_CATEGORY="general"
	section_begin "General" safe "$DESC_GENERAL"

	# 42 / shell leftovers
	remove_glob "42 cache" "$HOME"/.42*
	remove_glob "Zsh completion dump" "$HOME"/.zcompdump*

	# Trash
	remove_glob "Trash files" "$HOME"/.local/share/Trash/files/*
	remove_glob "Trash info" "$HOME"/.local/share/Trash/info/*

	# General cache
	remove_glob "User cache" "$HOME"/.cache/*

	# Thumbnails
	remove_glob "Thumbnails" "$HOME"/.cache/thumbnails/*
	remove_glob "Thumbnails (legacy)" "$HOME"/.thumbnails/*

	# Desktop junk
	remove_glob ".DS_Store" "$HOME"/Desktop/**/*/.DS_Store
	remove_glob "Piscine Rules video" "$HOME"/Desktop/Piscine\ Rules\ *.mp4
	remove_glob "PLAY_ME.webloc" "$HOME"/Desktop/PLAY_ME.webloc

	# Obsidian (cache/render junk only, vault content untouched)
	remove_glob "Obsidian cache" "$HOME"/.config/obsidian/Cache/*
	remove_glob "Obsidian code cache" "$HOME"/.config/obsidian/Code\ Cache/*
	remove_glob "Obsidian GPU cache" "$HOME"/.config/obsidian/GPUCache/*
	remove_glob "Obsidian Dawn Graphite cache" "$HOME"/.config/obsidian/DawnGraphiteCache/*
	remove_glob "Obsidian Dawn WebGPU cache" "$HOME"/.config/obsidian/DawnWebGPUCache/*
	remove_glob "Obsidian shared dictionary cache" "$HOME"/.config/obsidian/Shared\ Dictionary/cache/*

	# Prism Launcher (Minecraft launcher cache/logs, instances untouched)
	remove_glob "Prism Launcher cache" "$HOME"/.local/share/PrismLauncher/cache/*
	remove_glob "Prism Launcher logs" "$HOME"/.local/share/PrismLauncher/logs/*

	# GNOME Extension Manager
	remove_glob "Extension Manager cache" "$HOME"/.var/app/com.mattjakeman.ExtensionManager/cache/*

	# Clipboard history
	remove_glob "Clipboard history cache" "$HOME"/.cache/clipboard-history@alexsaveau.dev/*

	# Stray log files anywhere under HOME (safe: logs are disposable) —
	# EXCEPT inside any app's config/ tree (~/.config/* and every
	# ~/.var/app/*/config/*). Several storage backends (LevelDB, used by
	# Chrome's "Extension State", "Local Extension Settings", IndexedDB,
	# Local Storage, and similar stores in other Electron/Chromium apps)
	# name their live, uncommitted data files "*.log" — that is NOT a
	# debug log, and deleting it corrupts/resets the database (this is
	# what was silently resetting extension settings before). Real
	# disposable *.log files (build output, app logs, project dirs) are
	# almost always outside these config trees, so this exclusion is
	# safe and broad rather than a narrow, easy-to-miss allowlist.
	#
	# NOTE: these loops read from process substitution (not a pipe) so
	# they run in the current shell and their sizes reach the summary.
	local f
	while IFS= read -r -d '' f; do
		remove_path "$f" "Stray log"
	done < <(find "$HOME" -type f -name "*.log" \
		-not -path "$HOME/.config/*" \
		-not -path "$HOME/.var/app/*/config/*" \
		-print0 2>/dev/null)

	while IFS= read -r -d '' f; do
		remove_path "$f" "Old log (LOG.old)"
	done < <(find "$HOME" -type f -name "LOG.old" \
		-not -path "$HOME/.config/*" \
		-not -path "$HOME/.var/app/*/config/*" \
		-print0 2>/dev/null)

	# /tmp files owned by user
	# We enumerate both dry-run and real mode so stats are accurate.
	local p
	for p in /tmp/*; do
		[ ! -e "$p" ] && continue
		[ ! -O "$p" ] && continue
		remove_path "$p" "Temp file"
	done

	section_end
}

clean_python() {
	CURRENT_CATEGORY="python"
	section_begin "Python" safe "$DESC_PYTHON"

	# pip / Python
	remove_glob "pip cache" "$HOME"/.cache/pip
	remove_glob "pip user cache" "$HOME"/.local/share/pip-cache/*
	remove_glob "pytest cache" "$HOME"/.cache/pytest/*
	remove_glob "mypy cache" "$HOME"/.cache/mypy/*
	remove_glob "Ruff cache" "$HOME"/.cache/ruff/*
	remove_glob "uv cache" "$HOME"/.cache/uv/*

	# JS package manager caches
	remove_glob "npm cache" "$HOME"/.npm/_cacache/*
	remove_glob "Yarn cache" "$HOME"/.yarn/cache/*
	remove_glob "pnpm cache" "$HOME"/.cache/pnpm/*
	remove_glob "pnpm store cache" "$HOME"/.local/share/pnpm/store/*

	# Rust / Ruby
	remove_glob "Cargo registry cache" "$HOME"/.cargo/registry/cache/*
	remove_glob "Cargo git cache" "$HOME"/.cargo/git/db/*
	remove_glob "Ruby gem cache" "$HOME"/.gem/ruby/*/cache/*

	# Optional safe Python project junk:
	# remove per-project __pycache__ and .pytest_cache only under HOME,
	# but avoid .venv directories entirely.
	#
	# If you want this disabled, remove this block.
	local d f
	while IFS= read -r -d '' d; do
		remove_path "$d" "__pycache__"
	done < <(find "$HOME" \
		-type d \
		-name "__pycache__" \
		-not -path "*/.venv/*" \
		-not -path "$HOME/.cache/*" \
		-print0 2>/dev/null)

	while IFS= read -r -d '' d; do
		remove_path "$d" ".pytest_cache"
	done < <(find "$HOME" \
		-type d \
		-name ".pytest_cache" \
		-not -path "*/.venv/*" \
		-print0 2>/dev/null)

	# Stray compiled Python files (.pyc/.pyo) anywhere under HOME, outside
	# .venv. Safe: these are regenerated automatically by the interpreter.
	while IFS= read -r -d '' f; do
		remove_path "$f" ".pyc file"
	done < <(find "$HOME" -type f -name "*.pyc" -not -path "*/.venv/*" -print0 2>/dev/null)

	while IFS= read -r -d '' f; do
		remove_path "$f" ".pyo file"
	done < <(find "$HOME" -type f -name "*.pyo" -not -path "*/.venv/*" -print0 2>/dev/null)

	section_end
}

clean_vscode() {
