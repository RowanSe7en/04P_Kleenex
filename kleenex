	base="$(app_base zen)"
	[ ! -d "$base" ] && return 0

	# Zen is Firefox-based (same Gecko cache layout), so this mirrors
	# clean_firefox_cache() exactly. Flatpak-level cache first.
	remove_literal_dir_contents "$base/cache" "Flatpak cache"

	# Zen's Flatpak profile lives under .var/app/app.zen_browser.zen/.zen/
	# (about:profiles confirms the exact folder name per machine). Sweep
	# only cache/thumbnail dirs, same as Firefox — never places.sqlite,
	# logins.json, cookies, sessionstore, or zen-themes.json.
	for p in "$base"/.zen/*.default* "$base"/zen/*.default*; do
		[ -d "$p" ] || continue
		remove_literal_dir_contents "$p/cache2" "Profile cache"
		remove_literal_dir_contents "$p/startupCache" "Startup cache"
		remove_literal_dir_contents "$p/shader-cache" "Shader cache"
		remove_literal_dir_contents "$p/thumbnails" "Thumbnails"
		remove_literal_dir_contents "$p/OfflineCache" "Offline cache"
	done
}

clean_brave_cache() {
	local base p

	base="$(app_base brave)"
	[ ! -d "$base" ] && return 0

	# Flatpak-level cache
	remove_literal_dir_contents "$base/cache" "Flatpak cache"

	# Brave is Chromium-based: same cache folder names as Chrome, per
	# profile, under config/BraveSoftware/Brave-Browser. None of these
	# touch Login Data, History, Cookies, Sessions, or extension data.
	for p in "$base"/config/BraveSoftware/Brave-Browser/Default \
		"$base"/config/BraveSoftware/Brave-Browser/Profile*; do
		[ -d "$p" ] || continue
		# Only the two cache subdirs of Service Worker/ — never the
		# whole folder. Service Worker/ServiceWorkerDatabase holds
		# registration metadata for every installed service worker,
		# including every extension's MV3 background service worker.
		remove_literal_dir_contents "$p/Service Worker/CacheStorage" "Service Worker cache"
		remove_literal_dir_contents "$p/Service Worker/ScriptCache" "Service Worker scripts"
		remove_literal_dir_contents "$p/GPUCache" "GPU cache"
		remove_literal_dir_contents "$p/DawnWebGPUCache" "Dawn WebGPU cache"
		remove_literal_dir_contents "$p/DawnGraphiteCache" "Dawn Graphite cache"
		remove_literal_dir_contents "$p/Code Cache" "Code cache"
		remove_literal_dir_contents "$p/Cache" "Cache"
		remove_literal_dir_contents "$p/Application Cache" "Application cache"
		remove_literal_dir_contents "$p/blob_storage" "Blob storage"
		# NOTE: File System/ intentionally NOT cleaned — it backs the
		# sandboxed Filesystem API, which extensions/web apps can use
		# to persist real data, not just cache.
	done

	remove_literal_dir_contents \
		"$base/config/BraveSoftware/Brave-Browser/ShaderCache" \
		"Shader cache"
	remove_literal_dir_contents \
		"$base/config/BraveSoftware/Brave-Browser/GrShaderCache" \
		"Gr shader cache"
	remove_literal_dir_contents \
		"$base/config/BraveSoftware/Brave-Browser/Crash Reports" \
		"Crash reports"
}

clean_discord_cache() {
	local base

	base="$(app_base discord)"
	[ ! -d "$base" ] && return 0

	# Flatpak-level cache
	remove_literal_dir_contents "$base/cache" "Flatpak cache"

	# Discord is Electron-based; these are pure cache/render junk, never
	# the login token or account data (those live elsewhere in config).
	remove_literal_dir_contents "$base/config/discord/Cache" "Cache"
	remove_literal_dir_contents "$base/config/discord/Code Cache" "Code cache"
	remove_literal_dir_contents "$base/config/discord/GPUCache" "GPU cache"
	remove_literal_dir_contents "$base/config/discord/DawnWebGPUCache" "Dawn WebGPU cache"
	remove_literal_dir_contents "$base/config/discord/DawnGraphiteCache" "Dawn Graphite cache"
	# Only the cache subdirs of Service Worker/, never the whole folder
	# (ServiceWorkerDatabase holds service worker registration metadata).
	remove_literal_dir_contents "$base/config/discord/Service Worker/CacheStorage" "Service Worker cache"
	remove_literal_dir_contents "$base/config/discord/Service Worker/ScriptCache" "Service Worker scripts"
	remove_literal_dir_contents "$base/config/discord/blob_storage" "Blob storage"
	remove_literal_dir_contents "$base/config/discord/Crash Reports" "Crash reports"
}

clean_spotify_cache() {
	local base

	base="$(app_base spotify)"
	[ ! -d "$base" ] && return 0

	# Flatpak-level cache
	remove_literal_dir_contents "$base/cache" "Flatpak cache"

	# Spotify (Electron-based) cache/render junk only, never
	# Users/<id>/prefs or the local credentials cache.
	remove_literal_dir_contents "$base/config/spotify/Cache" "Cache"
	remove_literal_dir_contents "$base/config/spotify/Code Cache" "Code cache"
	remove_literal_dir_contents "$base/config/spotify/GPUCache" "GPU cache"
	# Only the cache subdirs of Service Worker/, never the whole folder
	# (ServiceWorkerDatabase holds service worker registration metadata).
	remove_literal_dir_contents "$base/config/spotify/Service Worker/CacheStorage" "Service Worker cache"
	remove_literal_dir_contents "$base/config/spotify/Service Worker/ScriptCache" "Service Worker scripts"
	remove_literal_dir_contents "$base/config/spotify/blob_storage" "Blob storage"
	remove_literal_dir_contents "$base/config/spotify/Browser/Cache" "Browser cache"
}

clean_firefox() {
	begin_app_section firefox "Firefox" safe "$DESC_APP" || return 0
	clean_firefox_cache
	section_end
}

clean_brave() {
	begin_app_section brave "Brave" safe "$DESC_APP" || return 0
	clean_brave_cache
	section_end
}

clean_discord() {
	begin_app_section discord "Discord" safe "$DESC_APP" || return 0
	clean_discord_cache
	section_end
}

clean_spotify() {
	begin_app_section spotify "Spotify" safe "$DESC_APP" || return 0
	clean_spotify_cache
	section_end
}

clean_zen() {
	begin_app_section zen "Zen Browser" safe "$DESC_APP" || return 0
	clean_zen_cache
	section_end
}

clean_extreme() {
	CURRENT_CATEGORY="extreme"

	local any_app_flag=0
	[ "$EXTREME_FIREFOX" -eq 1 ] && any_app_flag=1
	[ "$EXTREME_BRAVE" -eq 1 ]   && any_app_flag=1
	[ "$EXTREME_DISCORD" -eq 1 ] && any_app_flag=1
	[ "$EXTREME_SPOTIFY" -eq 1 ] && any_app_flag=1
	[ "$EXTREME_ZEN" -eq 1 ]     && any_app_flag=1
	[ "$EXTREME_CHROME" -eq 1 ]  && any_app_flag=1
	[ "$EXTREME_VSCODE" -eq 1 ]  && any_app_flag=1

	section_begin "Wipe" wipe "$DESC_WIPE"

	# No app flag given alongside --wipe: fall back to wiping every
	# supported app (old "purge everything" behavior), still one
	# confirmation prompt per app.
	if [ "$any_app_flag" -eq 0 ]; then
		EXTREME_FIREFOX=1
		EXTREME_BRAVE=1
		EXTREME_DISCORD=1
		EXTREME_SPOTIFY=1
		EXTREME_ZEN=1
		EXTREME_CHROME=1
		EXTREME_VSCODE=1
		printf "    %s⚠ No app flag given with --wipe: targeting all supported apps (%s).%s\n" \
			"$C_WARN" "${EXTREME_SUPPORTED_APPS[*]}" "$C_RESET"
	fi

	if [ "$EXTREME_FIREFOX" -eq 1 ]; then
		extreme_wipe_app_dir "Firefox" "$(app_base firefox)"
	fi

	if [ "$EXTREME_BRAVE" -eq 1 ]; then
		extreme_wipe_app_dir "Brave" "$(app_base brave)"
	fi

	if [ "$EXTREME_DISCORD" -eq 1 ]; then
		extreme_wipe_app_dir "Discord" "$(app_base discord)"
	fi

	if [ "$EXTREME_SPOTIFY" -eq 1 ]; then
		extreme_wipe_app_dir "Spotify" "$(app_base spotify)"
	fi

	if [ "$EXTREME_ZEN" -eq 1 ]; then
		extreme_wipe_app_dir "Zen Browser" "$(app_base zen)"
	fi

	if [ "$EXTREME_CHROME" -eq 1 ]; then
		extreme_wipe_app_dir "Chrome" "$(app_base chrome)"
	fi

	if [ "$EXTREME_VSCODE" -eq 1 ]; then
		extreme_wipe_app_dir "VS Code" "$(app_base vscode)"
	fi

	echo
	section_end "Nothing wiped" "wiped"
}

###############################################################################
# RUNNERS
###############################################################################

run_only_category() {
	case "$ONLY_CATEGORY" in
		general) clean_general ;;
		python)  clean_python ;;
		vscode)  clean_vscode ;;
		chrome)  clean_chrome ;;
		firefox) clean_firefox ;;
		brave)   clean_brave ;;
		discord) clean_discord ;;
		spotify) clean_spotify ;;
		zen)     clean_zen ;;
	esac
}

run_default_clean() {
	clean_general
	clean_python
	clean_vscode
	clean_chrome
	[ "$DEFAULT_CACHE_FIREFOX" -eq 1 ] && clean_firefox
	[ "$DEFAULT_CACHE_BRAVE" -eq 1 ]   && clean_brave
	[ "$DEFAULT_CACHE_DISCORD" -eq 1 ] && clean_discord
	[ "$DEFAULT_CACHE_SPOTIFY" -eq 1 ] && clean_spotify
	[ "$DEFAULT_CACHE_ZEN" -eq 1 ]     && clean_zen
}

run_extreme() {
	clean_extreme
}

run_mode_label() {
	local label

	if [ -n "$ONLY_CATEGORY" ]; then
		label="Only: $ONLY_CATEGORY"
	elif [ "$EXTREME_ONLY" -eq 1 ]; then
		label="Wipe only"
	elif [ "$EXTREME" -eq 1 ]; then
		label="Safe clean + wipe"
	else
		label="Safe clean (full default)"
	fi

	[ "$DRY_RUN" -eq 1 ] && label="$label · dry run"
	echo "$label"
}

###############################################################################
# SUMMARY
###############################################################################

print_summary_line() {
	# print_summary_line "Name" found freed
	local name="$1"
	local found="$2"
	local freed="$3"
	local shown="$freed"

	[ "$DRY_RUN" -eq 1 ] && shown="$found"

	if [ "$found" -eq 0 ]; then
		printf "    %s%-14s %10s %12s%s\n" "$C_MUTED" "$name" "—" "—" "$C_RESET"
	else
		printf "    %-14s %10s %s%12s%s\n" \
			"$name" "$(human_size "$found")" "$C_OK" "$(human_size "$shown")" "$C_RESET"
	fi
}

print_summary() {
	local freed_col="Freed"
	local total_shown="$TOTAL_FREED_BYTES"

	if [ "$DRY_RUN" -eq 1 ]; then
		freed_col="Would free"
		total_shown="$TOTAL_FOUND_BYTES"
	fi

	heading "Summary"
	printf "    %s%-14s %10s %12s%s\n" "$C_MUTED" "Category" "Found" "$freed_col" "$C_RESET"

	print_summary_line "General"     "$GENERAL_FOUND" "$GENERAL_FREED"
	print_summary_line "Python"      "$PYTHON_FOUND"  "$PYTHON_FREED"
	print_summary_line "VS Code"     "$VSCODE_FOUND"  "$VSCODE_FREED"
	print_summary_line "Chrome"      "$CHROME_FOUND"  "$CHROME_FREED"
	print_summary_line "Firefox"     "$FIREFOX_FOUND" "$FIREFOX_FREED"
	print_summary_line "Brave"       "$BRAVE_FOUND"   "$BRAVE_FREED"
	print_summary_line "Discord"     "$DISCORD_FOUND" "$DISCORD_FREED"
	print_summary_line "Spotify"     "$SPOTIFY_FOUND" "$SPOTIFY_FREED"
	print_summary_line "Zen Browser" "$ZEN_FOUND"     "$ZEN_FREED"
	[ "$EXTREME" -eq 1 ] && print_summary_line "Wipe" "$EXTREME_FOUND" "$EXTREME_FREED"

	printf "    %s%s%s\n" "$C_MUTED" "──────────────────────────────────────────" "$C_RESET"
	printf "    %s%-14s %10s %12s%s\n" "$C_BOLD" "Total" \
		"$(human_size "$TOTAL_FOUND_BYTES")" "$(human_size "$total_shown")" "$C_RESET"
	printf "    %s%-14s %10s%s\n" "$C_MUTED" "Targets" "$TOTAL_TARGETS" "$C_RESET"
}

###############################################################################
# MAIN
###############################################################################

banner

if [ "$ANALYZE" -eq 1 ]; then
	run_analyze
fi

if [ "$ANY_OPTION_SET" -ne 1 ]; then
	ui_warn "No action specified. Use --safe/-s to run the full clean, or --help for options."
	exit 0
fi

# --analyze is a read-only report. If it's the only thing requested,
# stop here: never delete anything just because --analyze was passed.
if [ "$ANALYZE" -eq 1 ] && [ -z "$ONLY_CATEGORY" ] \
	&& [ "$DEFAULT_RUN" -ne 1 ] && [ "$DRY_RUN" -ne 1 ] && [ "$PRINT_ITEMS" -ne 1 ] \
	&& [ "$AUTO_YES" -ne 1 ] && [ "$EXTREME" -ne 1 ]; then
	exit 0
fi

before_storage="$(get_storage)"
before_storage_bytes="$(get_storage_bytes)"

echo
ui_info "Mode:               ${C_BOLD}$(run_mode_label)${C_RESET}"
ui_info "Available storage:  ${C_BOLD}${before_storage}${C_RESET}"
if [ "$DRY_RUN" -eq 1 ]; then
	ui_info "Scanning ..."
else
	ui_info "Cleaning ..."
fi

if [ -n "$ONLY_CATEGORY" ]; then
	run_only_category
elif [ "$EXTREME_ONLY" -eq 1 ]; then
	# --wipe on its own (no --safe/-s): run ONLY the extreme wipe,
	# nothing else gets touched.
	run_extreme
elif [ "$EXTREME" -eq 1 ]; then
	# --wipe combined with --safe/-s: run the full safe clean,
	# then also run the extreme wipe.
	run_default_clean
	run_extreme
else
	run_default_clean
fi

after_storage="$(get_storage)"
after_storage_bytes="$(get_storage_bytes)"
storage_delta_bytes=$((after_storage_bytes - before_storage_bytes))

print_summary

heading "Storage"
if [ "$DRY_RUN" -eq 1 ]; then
	kv "Available" "$after_storage"
	echo
	ui_warn "DRY RUN complete — no files were deleted."
else
	kv "Before" "$before_storage"
	kv "After" "$after_storage" "$C_OK"
	if [ "$storage_delta_bytes" -ge 0 ]; then
		kv "Freed" "$(human_size "$storage_delta_bytes")  (disk delta)" "$C_OK$C_BOLD"
	else
		kv "Freed" "disk usage grew by $(human_size "$((storage_delta_bytes * -1))") during the run, see Summary above" "$C_WARN"
	fi
	echo
	ui_ok "${C_BOLD}Done.${C_RESET}"
fi

echo
