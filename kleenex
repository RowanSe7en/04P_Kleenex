#!/bin/bash
# Kleenex
#
# Made for 1337 Ubuntu PCs
# Made by Bilal Rouane — 42 intra: brouane
#
# Policy:
# - General cleanup: yes
# - Python/dev caches: aggressive cache cleanup, but NEVER delete whole .venv
# - VS Code: medium cleanup
# - Chrome: cleanup only
# - Obsidian / Prism Launcher / GNOME Extension Manager / clipboard
#   history / stray *.log/.pyc/.pyo files / Trash: cleanup only
# - Docker: untouched
# - Firefox / Brave / Discord / Spotify / Zen: CACHE-ONLY by default
#   (safe). Full wipe of their profile/login data (history, passwords,
#   sessions, saved logins, etc.) ONLY happens under --wipe, and only
#   for apps you explicitly opt into (or all five if no app flag is
#   given), with a confirmation prompt per app.
# - Browser extensions are NEVER touched by any stage, anywhere in this
#   script. Only true cache/temp/GPU/shader/crash-report/metrics dirs are
#   deleted; profiles, bookmarks, passwords, history, cookies, sessions,
#   preferences, and extension settings/storage are never targeted.
#   Concretely, that also means: Service Worker/ is only ever cleaned by
#   its CacheStorage/ScriptCache subdirs, never as a whole folder, since
#   the rest of it (ServiceWorkerDatabase) is the registration record for
#   every installed service worker — including every extension's MV3
#   background worker. File System/, Extension State/, Local Extension
#   Settings/, and Extension Scripts/ are never touched anywhere either,
#   for the same reason: they hold real extension data, not cache.
# - This script NEVER uninstalls any application. It only cleans files,
#   caches, logs, and temporary/junk data. Apps themselves (Flatpak,
#   Snap, apt, or otherwise) are never removed by any option here.
#
# Running with no arguments shows help (same as --help / -h).
# Any other recognized option runs immediately on its own (no --safe
# needed): --safe-dry-run/-sdr, --print, --wipe/-w, --only/-o CATEGORY, and
# --yes all act standalone. Options that don't pick a specific stage
# (--only) or an extreme-only run (--firefox/--brave/--discord/--spotify/
# --zen without --safe) fall back to the full default clean: general +
# python + vscode + chrome + firefox-cache + brave-cache + discord-cache +
# spotify-cache + zen-cache + misc caches (Obsidian, Prism Launcher, GNOME
# Extension Manager, clipboard history, stray logs/.pyc/.pyo, Trash).
# Use --safe / -s to run that full default clean explicitly.
#
# --analyze / -a is read-only: used alone it only reports the biggest
# space consumers in your HOME and exits, it never deletes anything. It
# also reports total/used/available disk space on the filesystem behind
# $HOME. Combine --analyze with another action (e.g. --analyze -s) to
# see the report before that action runs.
#
# SAFE vs EXTREME, in one sentence:
#   -s cleans caches everywhere (including Firefox/Brave/Discord/Spotify/
#   Zen cache folders, plus Obsidian/Prism/clipboard-history/logs/etc.)
#   and NEVER touches your saved logins/history/sessions.
#   --wipe / -w is the only thing that deletes a whole app's profile
#   data, and you choose which app(s) with --firefox / --brave /
#   --discord / --spotify / --zen (omit all of them to extreme-wipe
#   every supported app). --wipe now also covers Chrome and VS Code:
#   their Flatpak data dirs are fully wiped too when targeted, not just
#   their caches. --wipe NEVER uninstalls the app itself, only its
#   data — the app stays installed.
#
# Every path-based cleanup target is safe to run even if the path
# doesn't exist on this machine: missing files/dirs are silently
# skipped, never treated as an error.
#
# Output style: every category prints the same way —
#   ▌ Name   MODE   what it cleans
#       items (with --print / --safe-dry-run)
#       ✔ N items · SIZE freed
# Colors are disabled automatically when output is not a terminal, or
# when NO_COLOR is set. Set FORCE_COLOR=1 to keep them in a pipe.
#
# Useful examples:
#   ./Kleenex
#   ./Kleenex --safe
#   ./Kleenex --safe-dry-run
#   ./Kleenex -sdr
#   ./Kleenex --analyze
#   ./Kleenex -a -s
#   ./Kleenex --only vscode
#   ./Kleenex -o zen
#   ./Kleenex --wipe --brave
#   ./Kleenex -w --discord
#   ./Kleenex --wipe --brave --discord --zen
#   ./Kleenex --wipe --chrome --vscode
#   ./Kleenex --wipe --yes      # wipes ALL supported apps, no prompts

###############################################################################
# SHELL / SAFETY
###############################################################################

set +e
shopt -s nullglob

###############################################################################
# CONFIG
###############################################################################

SCRIPT_NAME="$(basename "$0")"

# Apps whose CACHE is cleaned by the default safe run (1 = clean, 0 = skip).
# This never touches history, passwords, sessions, or other profile data.
DEFAULT_CACHE_FIREFOX=1
DEFAULT_CACHE_BRAVE=1
DEFAULT_CACHE_DISCORD=1
DEFAULT_CACHE_SPOTIFY=1
DEFAULT_CACHE_ZEN=1

# Apps fully wiped (entire profile dir, including logins/history/sessions)
# ONLY when --wipe is used. These are just the "supported" list; which
# of them actually run is controlled by EXTREME_* flags set from --firefox
# / --brave / --discord / --spotify / --zen / --chrome / --vscode
# (see FLAGS below).
EXTREME_SUPPORTED_APPS=(firefox brave discord spotify zen chrome vscode)

# One-line descriptions shown next to each category header.
DESC_GENERAL="Trash, caches, temp files, logs & misc app caches"
DESC_PYTHON="Package & dev caches, __pycache__, .pyc/.pyo  (.venv untouched)"
DESC_VSCODE="Caches, logs & history  (settings, snippets & extensions kept)"
DESC_APP="Caches & temp data  (logins, history & settings untouched)"
DESC_WIPE="Full data wipe  (profiles, history, logins, sessions & settings)"

###############################################################################
# FLAGS
###############################################################################

DRY_RUN=0
PRINT_ITEMS=0
ANALYZE=0
AUTO_YES=0
EXTREME=0
EXTREME_ONLY=0
EXTREME_FIREFOX=0
EXTREME_BRAVE=0
EXTREME_DISCORD=0
EXTREME_SPOTIFY=0
EXTREME_ZEN=0
EXTREME_CHROME=0
EXTREME_VSCODE=0
DEFAULT_RUN=0
ONLY_CATEGORY=""
ANY_OPTION_SET=0

###############################################################################
# COLORS
###############################################################################
# Palette: sky-blue accent, green = ok, amber = caution, red = danger,
# grey = secondary text. Real escape characters are stored (not "\033"
# text) so the same variables work in printf, echo and heredocs.

if { [ -t 1 ] || [ -n "${FORCE_COLOR:-}" ]; } && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != "dumb" ]; then
	C_RESET=$'\033[0m'
	C_BOLD=$'\033[1m'
	C_DIM=$'\033[2m'
	C_ACCENT=$'\033[38;5;39m'
	C_INFO=$'\033[38;5;75m'
	C_OK=$'\033[38;5;78m'
	C_WARN=$'\033[38;5;221m'
	C_ERR=$'\033[38;5;203m'
	C_MUTED=$'\033[38;5;245m'
else
	C_RESET="" C_BOLD="" C_DIM="" C_ACCENT="" C_INFO=""
	C_OK="" C_WARN="" C_ERR="" C_MUTED=""
fi

###############################################################################
# STATS
###############################################################################

TOTAL_TARGETS=0
TOTAL_FOUND_BYTES=0
TOTAL_FREED_BYTES=0

GENERAL_FOUND=0
GENERAL_FREED=0

PYTHON_FOUND=0
PYTHON_FREED=0

VSCODE_FOUND=0
VSCODE_FREED=0

CHROME_FOUND=0
CHROME_FREED=0

FIREFOX_FOUND=0
FIREFOX_FREED=0

BRAVE_FOUND=0
BRAVE_FREED=0

DISCORD_FOUND=0
DISCORD_FREED=0

SPOTIFY_FOUND=0
SPOTIFY_FREED=0

ZEN_FOUND=0
ZEN_FREED=0

EXTREME_FOUND=0
EXTREME_FREED=0

CURRENT_CATEGORY=""

# Snapshots taken when a category header is printed (for its subtotal).
SECTION_T0=0
SECTION_F0=0
SECTION_R0=0

# Dry-run only: paths already counted, so a file inside a directory that
# was already counted is not counted a second time.
declare -A SEEN_PATHS=()

###############################################################################
# OUTPUT HELPERS (one look for every message in the script)
###############################################################################

ui_ok()   { printf "  %s✔%s %s\n" "$C_OK" "$C_RESET" "$*"; }
ui_info() { printf "  %s›%s %s\n" "$C_INFO" "$C_RESET" "$*"; }
ui_warn() { printf "  %s⚠%s %s%s%s\n" "$C_WARN" "$C_RESET" "$C_WARN" "$*" "$C_RESET"; }
ui_err()  { printf "  %s✖ %s%s\n" "$C_ERR" "$*" "$C_RESET" >&2; }

fg256() {
	# 256-color foreground escape, or nothing when colors are off.
	[ -n "$C_RESET" ] && printf '\033[38;5;%sm' "$1"
}

rule() {
	local i line=""
	for ((i = 0; i < 58; i++)); do line+="─"; done
	printf "  %s%s%s\n" "$C_MUTED" "$line" "$C_RESET"
}

heading() {
	printf "\n  %s▌%s %s%s%s\n" "$C_ACCENT" "$C_RESET" "$C_BOLD" "$1" "$C_RESET"
}

kv() {
	# kv "Label" "value" [color]
	printf "    %s%-12s%s %s%s%s\n" "$C_MUTED" "$1" "$C_RESET" "${3:-$C_BOLD}" "$2" "$C_RESET"
}

short_path() {
	# Show $HOME as ~ to keep item lines readable.
	local p="$1"
	case "$p" in
		"$HOME") printf '~' ;;
		"$HOME"/*) printf '%s' "~${p#"$HOME"}" ;;
		*) printf '%s' "$p" ;;
	esac
}

section_begin() {
	# section_begin "Name" safe|medium|wipe "what it cleans"
	local tag tagc
	case "$2" in
		safe)   tag="SAFE";   tagc="$C_OK" ;;
		medium) tag="MEDIUM"; tagc="$C_WARN" ;;
		wipe)   tag="WIPE";   tagc="$C_ERR" ;;
		*)      tag="";       tagc="" ;;
	esac

	SECTION_T0=$TOTAL_TARGETS
	SECTION_F0=$TOTAL_FOUND_BYTES
	SECTION_R0=$TOTAL_FREED_BYTES

	printf "\n  %s▌%s %s%-12s%s %s%s%-6s%s  %s%s%s\n" \
		"$C_ACCENT" "$C_RESET" \
		"$C_BOLD" "$1" "$C_RESET" \
		"$C_BOLD" "$tagc" "$tag" "$C_RESET" \
		"$C_MUTED" "$3" "$C_RESET"
}

section_skip() {
	printf "    %s↷ %s%s\n" "$C_MUTED" "$*" "$C_RESET"
}

section_end() {
	# section_end ["empty message"] ["verb"]
	local empty_msg="${1:-Already clean}"
	local verb="${2:-freed}"
	local n=$((TOTAL_TARGETS - SECTION_T0))
	local found=$((TOTAL_FOUND_BYTES - SECTION_F0))
	local freed=$((TOTAL_FREED_BYTES - SECTION_R0))
	local noun="items"
	[ "$n" -eq 1 ] && noun="item"

	if [ "$n" -eq 0 ]; then
		printf "    %s✔ %s%s\n" "$C_MUTED" "$empty_msg" "$C_RESET"
	elif [ "$DRY_RUN" -eq 1 ]; then
		printf "    %s◦ %d %s · %s would be %s%s\n" \
			"$C_WARN" "$n" "$noun" "$(human_size "$found")" "$verb" "$C_RESET"
	else
		printf "    %s✔ %d %s · %s %s%s\n" \
			"$C_OK" "$n" "$noun" "$(human_size "$freed")" "$verb" "$C_RESET"
	fi
}

###############################################################################
# BANNER / HELP
###############################################################################

banner() {
	# K L E E N E X — one gradient color per letter (deep blue -> ice blue)
	local g=(27 33 39 45 51 87 123)
	local r1=("█  ▄▀" "█    " "█▀▀▀▀" "█▀▀▀▀" "█▄  █" "█▀▀▀▀" "▀▄ ▄▀")
	local r2=("█▀▄  " "█    " "█▀▀▀ " "█▀▀▀ " "█ ▀▄█" "█▀▀▀ " "  █  ")
	local r3=("█  ▀▄" "█▄▄▄▄" "█▄▄▄▄" "█▄▄▄▄" "█   █" "█▄▄▄▄" "▄▀ ▀▄")

	local l1="" l2="" l3="" c i

	for i in "${!r1[@]}"; do
		c="$(fg256 "${g[i]}")"
		l1+="${c}${r1[i]}  "
		l2+="${c}${r2[i]}  "
		l3+="${c}${r3[i]}  "
	done

	echo
	printf "  %s\n" "${C_BOLD}${l1}${C_RESET}"
	printf "  %s\n" "${C_BOLD}${l2}${C_RESET}"
	printf "  %s\n" "${C_BOLD}${l3}${C_RESET}"
	echo
	printf "  %s%sWipe away the clutter%s  %s·  disk cleanup for 1337 Ubuntu PCs%s\n" \
		"$C_BOLD" "$C_ACCENT" "$C_RESET" "$C_MUTED" "$C_RESET"
	printf "  %sMade by Bilal Rouane · 42 intra: brouane%s\n" "$C_MUTED" "$C_RESET"
	rule

	if [ "$DRY_RUN" -eq 1 ]; then
		echo
		ui_warn "DRY RUN — nothing will be deleted."
	fi
}

help_heading() {
	printf "\n  %s%s%s\n" "$C_BOLD$C_ACCENT" "$1" "$C_RESET"
}

help_opt() {
	# help_opt "--flag, -f" "first line" ["more lines" ...]
	local flag="$1" line
	shift
	printf "    %s%-22s%s%s\n" "$C_INFO" "$flag" "$C_RESET" "$1"
	shift
	for line in "$@"; do
		printf "    %-22s%s%s%s\n" "" "$C_MUTED" "$line" "$C_RESET"
	done
}

usage() {
	printf "\n  %s%sKleenex%s  %s— disk cleanup for 1337 Ubuntu PCs%s\n" \
		"$C_BOLD" "$C_ACCENT" "$C_RESET" "$C_MUTED" "$C_RESET"

	help_heading "USAGE"
	cat <<EOF
    $SCRIPT_NAME [options]

    Running with no arguments shows this help. Any option below runs on
    its own; --only/-o and --wipe/-w each run just their own stage,
    everything else (--safe-dry-run, --print, --yes) falls back to the
    full default clean unless combined with --only/--wipe.
    --analyze/-a is read-only: used by itself it just prints the report
    and exits, it never deletes anything.
EOF

	help_heading "OPTIONS"
	help_opt "--safe, -s" \
		"Safe cleanup (recommended): removes temporary files," \
		"caches, logs, Trash, Python cache (__pycache__, .pyc, .pyo," \
		"pip/uv/pytest/mypy), VS Code caches, browser caches (Chrome," \
		"Firefox, Brave, Discord, Spotify, Zen), and miscellaneous" \
		"application caches (Obsidian, Prism Launcher, GNOME Extension" \
		"Manager, clipboard history). Never deletes history, bookmarks," \
		"cookies, passwords, sessions, saved logins, extensions, or" \
		"extension settings."
	help_opt "--safe-dry-run, -sdr" "Show what would be deleted, do not delete"
	help_opt "--print, -p" "Print each target before deleting it"
	help_opt "--analyze, -a" \
		"Report-only: show biggest space consumers in your HOME," \
		"plus total/used/available disk space on the filesystem" \
		"behind \$HOME. Deletes nothing. Combine with another option" \
		"(e.g. --analyze -s) to see the report before it runs."
	help_opt "--only, -o CATEGORY" \
		"Run only one category:" \
		"general | python | vscode | chrome | firefox | brave |" \
		"discord | spotify | zen"
	help_opt "--wipe, -w" \
		"DANGEROUS. Fully wipe the entire local data dir of one or" \
		"more apps (see WIPE MODE). Always asks for confirmation" \
		"per app unless --yes is also given."
	help_opt "--firefox" "With --wipe: target Firefox"
	help_opt "--brave" "With --wipe: target Brave"
	help_opt "--discord" "With --wipe: target Discord"
	help_opt "--spotify" "With --wipe: target Spotify"
	help_opt "--zen" "With --wipe: target Zen Browser"
	help_opt "--chrome" "With --wipe: target Chrome"
	help_opt "--vscode" "With --wipe: target VS Code"
	help_opt "--yes, -y" "Auto-confirm wipe prompts (see WIPE MODE)"
	help_opt "--help, -h" "Show this help"

	help_heading "APP CACHE CATEGORIES  (safe, part of the default clean)"
	cat <<EOF
    firefox / brave / discord / spotify / zen each clean ONLY that app's
    CACHE folders (Flatpak installs under ~/.var/app) — things like
    Cache, Code Cache, GPUCache, Service Worker caches, shader caches.
    History, bookmarks, passwords, saved logins, sessions, preferences,
    and extension settings/storage are never touched. They run as part
    of the default clean, and can also be targeted directly:
      --only firefox / -o zen / etc.    clean just that one app's cache
      --safe-dry-run, -sdr              show what would be cleaned
EOF

	help_heading "WIPE MODE  (--wipe, -w)  DANGEROUS, OPT-IN, PER-APP"
	cat <<EOF
    This is the ONLY stage that deletes more than a cache: it removes an
    app's entire local data directory, including (for browsers) history,
    saved logins, passwords, active sessions, and (for VS Code) settings,
    keybindings, snippets, and installed extensions. It NEVER runs as
    part of the default clean and NEVER runs unless you pass --wipe/-w
    explicitly. It only ever deletes data — it never uninstalls the app
    itself; the app stays installed.

    Pick which app(s) to wipe with --firefox / --brave / --discord /
    --spotify / --zen / --chrome / --vscode. You can combine several. If
    --wipe is given with NONE of those app flags, it wipes ALL SEVEN
    supported apps (the old "purge everything" behavior) — so be careful
    with --wipe --yes on its own.

    Each targeted app shows its size and asks for an interactive y/N
    confirmation before it is wiped, unless --yes / -y is also given.
    --safe-dry-run / -sdr shows what wipe mode would remove, with no
    prompts and nothing deleted.
EOF

	help_heading "DEFAULT RUN"
	cat <<EOF
    --safe / -s, or any standalone flag with no --only or --wipe:
    general + python + vscode + chrome + firefox + brave + discord +
    spotify + zen caches + misc caches (never logins, profiles, or
    extension data).
EOF

	help_heading "EXAMPLES"
	cat <<EOF
    $SCRIPT_NAME
    $SCRIPT_NAME --safe
    $SCRIPT_NAME --safe-dry-run
    $SCRIPT_NAME -sdr
    $SCRIPT_NAME --analyze
    $SCRIPT_NAME -a -s
    $SCRIPT_NAME --only vscode
    $SCRIPT_NAME -o zen
    $SCRIPT_NAME --wipe --brave
    $SCRIPT_NAME -w --discord
    $SCRIPT_NAME --wipe --brave --discord --zen
    $SCRIPT_NAME --wipe --chrome --vscode
    $SCRIPT_NAME --wipe --yes        # wipes ALL supported apps, no prompts
EOF
	echo
}

###############################################################################
# ARG PARSING
###############################################################################

if [ $# -eq 0 ]; then
	usage
	exit 0
fi

while [ $# -gt 0 ]; do
	case "$1" in
		--safe|-s)
			DEFAULT_RUN=1
			ANY_OPTION_SET=1
			;;
		--safe-dry-run|-sdr)
			DRY_RUN=1
			ANY_OPTION_SET=1
			;;
		--print|-p)
			PRINT_ITEMS=1
			ANY_OPTION_SET=1
			;;
		--analyze|-a)
			ANALYZE=1
			ANY_OPTION_SET=1
			;;
		--only|-o)
			shift
			if [ -z "$1" ]; then
				ui_err "--only requires a category"
				usage
				exit 1
			fi
			ONLY_CATEGORY="$1"
			ANY_OPTION_SET=1
			;;
		--wipe|--extreem|-wipe|-extreem|-w)
			EXTREME=1
			EXTREME_ONLY=1
			ANY_OPTION_SET=1
			;;
		--firefox)
			EXTREME_FIREFOX=1
			ANY_OPTION_SET=1
			;;
		--brave)
			EXTREME_BRAVE=1
			ANY_OPTION_SET=1
			;;
		--discord)
			EXTREME_DISCORD=1
			ANY_OPTION_SET=1
			;;
		--spotify)
			EXTREME_SPOTIFY=1
			ANY_OPTION_SET=1
			;;
		--zen)
			EXTREME_ZEN=1
			ANY_OPTION_SET=1
			;;
		--chrome)
			EXTREME_CHROME=1
			ANY_OPTION_SET=1
			;;
		--vscode)
			EXTREME_VSCODE=1
			ANY_OPTION_SET=1
			;;
		--yes|-y)
			AUTO_YES=1
			ANY_OPTION_SET=1
			;;
		--help|-h)
			usage
			exit 0
			;;
		*)
			ui_err "Unknown option: $1"
			usage
			exit 1
			;;
	esac
	shift
done

case "$ONLY_CATEGORY" in
	""|general|python|vscode|chrome|firefox|brave|discord|spotify|zen)
		;;
	*)
		ui_err "Invalid category for --only: $ONLY_CATEGORY"
		usage
		exit 1
		;;
esac

# --firefox/--brave/--discord/--spotify/--zen/--chrome/--vscode only
# make sense alongside --wipe.
if [ "$EXTREME" -ne 1 ] && { [ "$EXTREME_FIREFOX" -eq 1 ] \
	|| [ "$EXTREME_BRAVE" -eq 1 ] || [ "$EXTREME_DISCORD" -eq 1 ] || [ "$EXTREME_SPOTIFY" -eq 1 ] \
	|| [ "$EXTREME_ZEN" -eq 1 ] || [ "$EXTREME_CHROME" -eq 1 ] || [ "$EXTREME_VSCODE" -eq 1 ]; }; then
	ui_err "--firefox/--brave/--discord/--spotify/--zen/--chrome/--vscode require --wipe"
	usage
	exit 1
fi

# If --wipe was combined with --safe/-s, it's no longer an
# extreme-only run: run the full safe clean AND the extreme wipe.
if [ "$DEFAULT_RUN" -eq 1 ] && [ "$EXTREME" -eq 1 ]; then
	EXTREME_ONLY=0
fi

###############################################################################
# GENERIC HELPERS
###############################################################################

app_base() {
	# Flatpak data dir for each supported app (single source of truth,
	# shared by the cache cleaners and by wipe mode).
	case "$1" in
		firefox) echo "$HOME/.var/app/org.mozilla.firefox" ;;
		brave)   echo "$HOME/.var/app/com.brave.Browser" ;;
		discord) echo "$HOME/.var/app/com.discordapp.Discord" ;;
		spotify) echo "$HOME/.var/app/com.spotify.Client" ;;
		zen)     echo "$HOME/.var/app/app.zen_browser.zen" ;;
		chrome)  echo "$HOME/.var/app/com.google.Chrome" ;;
		vscode)  echo "$HOME/.var/app/com.visualstudio.code" ;;
	esac
}

get_storage() {
	# Human-readable available space in $HOME's filesystem (for display).
	local storage
	storage=$(df -h "$HOME" | awk 'NR==2 {print $4}')
	[ -z "$storage" ] && storage="0B"
	echo "$storage"
}

get_storage_bytes() {
	# Available space in $HOME's filesystem, in bytes (for computing the delta).
	local bytes
	bytes=$(df -B1 "$HOME" | awk 'NR==2 {print $4}')
	[[ "$bytes" =~ ^[0-9]+$ ]] || bytes=0
	echo "$bytes"
}

print_disk_space() {
	# Total / used / available space for $HOME's filesystem, with a usage
	# bar (green < 70%, amber < 90%, red above). Used by --analyze to show
	# overall device storage, not just per-folder sizes.
	local line total used avail pct num width=30 filled i bar_on="" bar_off="" color

	line=$(df -h "$HOME" | awk 'NR==2 {print $2, $3, $4, $5}')
	if [ -z "$line" ]; then
		ui_warn "Could not read disk space for \$HOME"
		return 0
	fi

	read -r total used avail pct <<< "$line"

	num="${pct%\%}"
	[[ "$num" =~ ^[0-9]+$ ]] || num=0
	filled=$((num * width / 100))

	color="$C_OK"
	[ "$num" -ge 70 ] && color="$C_WARN"
	[ "$num" -ge 90 ] && color="$C_ERR"

	for ((i = 0; i < width; i++)); do
		if [ "$i" -lt "$filled" ]; then
			bar_on+="█"
		else
			bar_off+="░"
		fi
	done

	heading "Disk space  (filesystem behind ~)"
	printf "    %s%s%s%s%s  %s%s%s\n" "$color" "$bar_on" "$C_MUTED" "$bar_off" "$C_RESET" "$C_BOLD" "$pct" "$C_RESET"
	kv "Total" "$total"
	kv "Used" "$used ($pct)" "$color"
	kv "Available" "$avail" "$C_OK"
}

human_size() {
	# Bytes -> "123B", "4.5K", "12.3M", "1.2G" ...
	local bytes="$1"
	local units=("B" "K" "M" "G" "T")
	local i=0 value rem=0

	if ! [[ "$bytes" =~ ^[0-9]+$ ]]; then
		echo "0B"
		return
	fi

	value="$bytes"
	while [ "$value" -ge 1024 ] && [ "$i" -lt 4 ]; do
		rem=$(((value % 1024) * 10 / 1024))
		value=$((value / 1024))
		i=$((i + 1))
	done

	if [ "$i" -eq 0 ]; then
		echo "${value}B"
	else
		echo "${value}.${rem}${units[$i]}"
	fi
}

path_size_bytes() {
	local path="$1"

	[ ! -e "$path" ] && {
		echo 0
		return
	}

	du -sb "$path" 2>/dev/null | awk '{print $1}'
}

print_item() {
	# One line per target:  ✔   12.3M  Label            ~/path
	local label="$1"
	local bytes="$2"
	local path="$3"
	local icon icolor

	if [ "$DRY_RUN" -eq 1 ]; then
		icon="◦"
		icolor="$C_WARN"
	else
		icon="✔"
		icolor="$C_OK"
	fi

	printf "    %s%s%s %s%7s%s  %-30s %s%s%s\n" \
		"$icolor" "$icon" "$C_RESET" \
		"$C_BOLD" "$(human_size "$bytes")" "$C_RESET" \
		"$label" \
		"$C_MUTED" "$(short_path "$path")" "$C_RESET"
}

add_found_bytes() {
	local bytes="$1"

	TOTAL_FOUND_BYTES=$((TOTAL_FOUND_BYTES + bytes))

	case "$CURRENT_CATEGORY" in
		general)  GENERAL_FOUND=$((GENERAL_FOUND + bytes)) ;;
		python)   PYTHON_FOUND=$((PYTHON_FOUND + bytes)) ;;
		vscode)   VSCODE_FOUND=$((VSCODE_FOUND + bytes)) ;;
		chrome)   CHROME_FOUND=$((CHROME_FOUND + bytes)) ;;
		firefox)  FIREFOX_FOUND=$((FIREFOX_FOUND + bytes)) ;;
		brave)    BRAVE_FOUND=$((BRAVE_FOUND + bytes)) ;;
		discord)  DISCORD_FOUND=$((DISCORD_FOUND + bytes)) ;;
		spotify)  SPOTIFY_FOUND=$((SPOTIFY_FOUND + bytes)) ;;
		zen)      ZEN_FOUND=$((ZEN_FOUND + bytes)) ;;
		extreme)  EXTREME_FOUND=$((EXTREME_FOUND + bytes)) ;;
	esac
}

add_freed_bytes() {
	local bytes="$1"

	TOTAL_FREED_BYTES=$((TOTAL_FREED_BYTES + bytes))

	case "$CURRENT_CATEGORY" in
		general)  GENERAL_FREED=$((GENERAL_FREED + bytes)) ;;
		python)   PYTHON_FREED=$((PYTHON_FREED + bytes)) ;;
		vscode)   VSCODE_FREED=$((VSCODE_FREED + bytes)) ;;
		chrome)   CHROME_FREED=$((CHROME_FREED + bytes)) ;;
		firefox)  FIREFOX_FREED=$((FIREFOX_FREED + bytes)) ;;
		brave)    BRAVE_FREED=$((BRAVE_FREED + bytes)) ;;
		discord)  DISCORD_FREED=$((DISCORD_FREED + bytes)) ;;
		spotify)  SPOTIFY_FREED=$((SPOTIFY_FREED + bytes)) ;;
		zen)      ZEN_FREED=$((ZEN_FREED + bytes)) ;;
		extreme)  EXTREME_FREED=$((EXTREME_FREED + bytes)) ;;
	esac
}

already_counted() {
	# Dry-run helper: true if this path, or any parent of it, was already
	# counted (a real run would have deleted it, so it would not exist).
	local p="$1"

	while [ -n "$p" ] && [ "$p" != "/" ]; do
		[ -n "${SEEN_PATHS[$p]:-}" ] && return 0
		p="${p%/*}"
	done
	return 1
}

remove_path() {
	local path="$1"
	local label="$2"
	local bytes

	[ -z "$path" ] && return 0
	[ ! -e "$path" ] && return 0

	if [ "$DRY_RUN" -eq 1 ] && already_counted "$path"; then
		return 0
	fi

	bytes=$(path_size_bytes "$path")
	[ -z "$bytes" ] && bytes=0
	[ "$bytes" -eq 0 ] && return 0

	TOTAL_TARGETS=$((TOTAL_TARGETS + 1))
	add_found_bytes "$bytes"

	if [ "$PRINT_ITEMS" -eq 1 ] || [ "$DRY_RUN" -eq 1 ]; then
		print_item "$label" "$bytes" "$path"
	fi

	if [ "$DRY_RUN" -eq 1 ]; then
		SEEN_PATHS["$path"]=1
		return 0
	fi

	/bin/rm -rf -- "$path" 2>/dev/null
	add_freed_bytes "$bytes"
	return 0
}

remove_glob() {
	local label="$1"
	shift
	local path

	for path in "$@"; do
		remove_path "$path" "$label"
	done
}

remove_literal_dir_contents() {
	# Remove only the contents of a directory, not the directory itself.
	local dir="$1"
	local label="$2"

	[ ! -d "$dir" ] && return 0
	remove_glob "$label" "$dir"/*
}

confirm_prompt() {
	local prompt="$1"
	local answer

	if [ "$AUTO_YES" -eq 1 ] || [ "$DRY_RUN" -eq 1 ]; then
		return 0
	fi

	printf "    %s?%s %s%s%s %s[y/N]%s " \
		"$C_WARN" "$C_RESET" "$C_BOLD" "$prompt" "$C_RESET" "$C_MUTED" "$C_RESET"
	read -r answer

	case "$answer" in
		y|Y|yes|YES)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

extreme_wipe_app_dir() {
	local app_name="$1"
	local app_path="$2"
	local bytes

	if [ ! -e "$app_path" ]; then
		section_skip "$app_name — not found, skipped"
		return 0
	fi

	bytes=$(path_size_bytes "$app_path")
	[ -z "$bytes" ] && bytes=0
	if [ "$bytes" -eq 0 ]; then
		section_skip "$app_name — already empty, skipped"
		return 0
	fi

	printf "\n    %s⚠ %s%s%s%s  %swipes history, logins, sessions, everything%s\n" \
		"$C_ERR" "$C_BOLD" "$C_ERR" "$app_name" "$C_RESET" "$C_MUTED" "$C_RESET"
	printf "      %s%-6s%s %s\n" "$C_MUTED" "Path" "$C_RESET" "$(short_path "$app_path")"
	printf "      %s%-6s%s %s%s%s\n" "$C_MUTED" "Size" "$C_RESET" "$C_BOLD" "$(human_size "$bytes")" "$C_RESET"

	if ! confirm_prompt "Wipe $app_name?"; then
		section_skip "Skipped $app_name"
		return 0
	fi

	TOTAL_TARGETS=$((TOTAL_TARGETS + 1))
	add_found_bytes "$bytes"

	if [ "$DRY_RUN" -eq 1 ]; then
		printf "      %s◦ Would wipe %s · %s%s\n" "$C_WARN" "$app_name" "$(human_size "$bytes")" "$C_RESET"
		return 0
	fi

	/bin/rm -rf -- "$app_path" 2>/dev/null
	add_freed_bytes "$bytes"
	printf "      %s✔ Wiped %s · %s%s\n" "$C_OK" "$app_name" "$(human_size "$bytes")" "$C_RESET"
}

begin_app_section() {
	# begin_app_section key "Display name" safe|medium "description"
