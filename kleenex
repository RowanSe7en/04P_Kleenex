	remove_literal_dir_contents "$base/config/Code/Cache" "Cache"
	remove_literal_dir_contents "$base/config/Code/CachedData" "Cached data"
	remove_literal_dir_contents "$base/config/Code/CachedProfilesData" "Cached profiles data"
