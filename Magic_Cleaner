clean_firefox_cache() {
	local base="$HOME/.var/app/org.mozilla.firefox"
	local p

	[ ! -d "$base" ] && return 0

	# Flatpak-level cache
	remove_literal_dir_contents "$base/cache" "firefox flatpak cache"

	# Firefox keeps its real browser cache under
	# .var/app/.../cache/mozilla/firefox/<profile>/cache2 (and similar),
	# which the line above already covers. Also sweep profile-level
	# cache/thumbnail dirs without touching places.sqlite, logins.json,
	# cookies, or sessionstore — those stay completely untouched.
	for p in "$base"/config/mozilla/firefox/*.default* "$base"/.mozilla/firefox/*.default*; do
		[ -d "$p" ] || continue
		remove_literal_dir_contents "$p/cache2" "firefox profile cache2"
		remove_literal_dir_contents "$p/startupCache" "firefox startupCache"
		remove_literal_dir_contents "$p/shader-cache" "firefox shader-cache"
		remove_literal_dir_contents "$p/thumbnails" "firefox thumbnails"
		remove_literal_dir_contents "$p/OfflineCache" "firefox OfflineCache"
	done
}

