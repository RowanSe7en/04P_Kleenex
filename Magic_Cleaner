#!/bin/bash
# Magic_Cleaner
#
# Made for 1337 Ubuntu PCs
# Made by Bilal Rouane — 42 intra: brouane
#
# Policy:
# - General cleanup: yes
# - Python/dev caches: aggressive cache cleanup, but NEVER delete whole .venv
# - VS Code: medium cleanup
# - Chrome: cleanup only
# - Obsidian / Prism Launcher / GNOME Extension Manager / clipboard
#   history / stray *.log/.pyc/.pyo files / Trash: cleanup only
# - Docker: untouched
# - Firefox / Brave / Discord / Spotify / Zen: CACHE-ONLY by default
#   (safe). Full wipe of their profile/login data (history, passwords,
#   sessions, saved logins, etc.) ONLY happens under --wipe, and only
#   for apps you explicitly opt into (or all five if no app flag is
#   given), with a confirmation prompt per app.
# - Browser extensions are NEVER touched by any stage, anywhere in this
#   script. Only true cache/temp/GPU/shader/crash-report/metrics dirs are
#   deleted; profiles, bookmarks, passwords, history, cookies, sessions,
#   preferences, and extension settings/storage are never targeted.
#   Concretely, that also means: Service Worker/ is only ever cleaned by
#   its CacheStorage/ScriptCache subdirs, never as a whole folder, since
#   the rest of it (ServiceWorkerDatabase) is the registration record for
#   every installed service worker — including every extension's MV3
#   background worker. File System/, Extension State/, Local Extension
#   Settings/, and Extension Scripts/ are never touched anywhere either,
#   for the same reason: they hold real extension data, not cache.
# - This script NEVER uninstalls any application. It only cleans files,
#   caches, logs, and temporary/junk data. Apps themselves (Flatpak,
#   Snap, apt, or otherwise) are never removed by any option here.
#
# Running with no arguments shows help (same as --help / -h).
# Any other recognized option runs immediately on its own (no --safe
# needed): --safe-dry-run/-sdr, --print, --wipe/-w, --only/-o CATEGORY, and
# --yes all act standalone. Options that don't pick a specific stage
# (--only) or an extreme-only run (--firefox/--brave/--discord/--spotify/
# --zen without --safe) fall back to the full default clean: general +
# python + vscode + chrome + firefox-cache + brave-cache + discord-cache +
# spotify-cache + zen-cache + misc caches (Obsidian, Prism Launcher, GNOME
# Extension Manager, clipboard history, stray logs/.pyc/.pyo, Trash).
# Use --safe / -s to run that full default clean explicitly.
#
# --analyze / -a is read-only: used alone it only reports the biggest
# space consumers in your HOME and exits, it never deletes anything. It
# also reports total/used/available disk space on the filesystem behind
# $HOME. Combine --analyze with another action (e.g. --analyze -s) to
# see the report before that action runs.
#
# SAFE vs EXTREME, in one sentence:
#   -s cleans caches everywhere (including Firefox/Brave/Discord/Spotify/
#   Zen cache folders, plus Obsidian/Prism/clipboard-history/logs/etc.)
#   and NEVER touches your saved logins/history/sessions.
#   --wipe / -w is the only thing that deletes a whole app's profile
#   data, and you choose which app(s) with --firefox / --brave /
#   --discord / --spotify / --zen (omit all of them to extreme-wipe
#   every supported app). --wipe now also covers Chrome and VS Code:
#   their Flatpak data dirs are fully wiped too when targeted, not just
#   their caches. --wipe NEVER uninstalls the app itself, only its
#   data — the app stays installed.
#
# Every path-based cleanup target is safe to run even if the path
# doesn't exist on this machine: missing files/dirs are silently
# skipped, never treated as an error.
#
# Useful examples:
#   ./Magic_Cleaner
#   ./Magic_Cleaner --safe
#   ./Magic_Cleaner --safe-dry-run
#   ./Magic_Cleaner -sdr
#   ./Magic_Cleaner --analyze
#   ./Magic_Cleaner -a -s
#   ./Magic_Cleaner --only vscode
#   ./Magic_Cleaner -o zen
#   ./Magic_Cleaner --wipe --brave
#   ./Magic_Cleaner -w --discord
#   ./Magic_Cleaner --wipe --brave --discord --zen
#   ./Magic_Cleaner --wipe --chrome --vscode
#   ./Magic_Cleaner --wipe --yes      # wipes ALL supported apps, no prompts

###############################################################################
# SHELL / SAFETY
###############################################################################

set +e
shopt -s nullglob

###############################################################################
# CONFIG
###############################################################################

SCRIPT_NAME="$(basename "$0")"

# Apps whose CACHE is cleaned by the default safe run (1 = clean, 0 = skip).
# This never touches history, passwords, sessions, or other profile data.
DEFAULT_CACHE_FIREFOX=1
DEFAULT_CACHE_BRAVE=1
DEFAULT_CACHE_DISCORD=1
DEFAULT_CACHE_SPOTIFY=1
DEFAULT_CACHE_ZEN=1

# Apps fully wiped (entire profile dir, including logins/history/sessions)
# ONLY when --wipe is used. These are just the "supported" list; which
# of them actually run is controlled by EXTREME_* flags set from --firefox
# / --brave / --discord / --spotify / --zen / --chrome / --vscode
# (see FLAGS below).
EXTREME_SUPPORTED_APPS=(firefox brave discord spotify zen chrome vscode)

###############################################################################
# FLAGS
###############################################################################

DRY_RUN=0
PRINT_ITEMS=0
ANALYZE=0
AUTO_YES=0
EXTREME=0
EXTREME_ONLY=0
EXTREME_FIREFOX=0
EXTREME_BRAVE=0
EXTREME_DISCORD=0
EXTREME_SPOTIFY=0
EXTREME_ZEN=0
EXTREME_CHROME=0
EXTREME_VSCODE=0
DEFAULT_RUN=0
ONLY_CATEGORY=""
ANY_OPTION_SET=0

###############################################################################
# COLORS
###############################################################################

C_RESET="\033[0m"
C_RED="\033[31m"
C_GREEN="\033[32m"
C_YELLOW="\033[33m"
C_BLUE="\033[34m"
C_ORANGE="\033[38;5;208m"
C_CYAN="\033[36m"
C_BOLD="\033[1m"
C_MAGENTA="\033[38;5;213m"
C_PURPLE="\033[38;5;141m"
C_DIM="\033[2m"

###############################################################################
# STATS
###############################################################################

TOTAL_TARGETS=0
TOTAL_FOUND_BYTES=0
TOTAL_FREED_BYTES=0

GENERAL_FOUND=0
GENERAL_FREED=0

PYTHON_FOUND=0
PYTHON_FREED=0

VSCODE_FOUND=0
VSCODE_FREED=0

CHROME_FOUND=0
CHROME_FREED=0

FIREFOX_FOUND=0
FIREFOX_FREED=0

BRAVE_FOUND=0
BRAVE_FREED=0

DISCORD_FOUND=0
DISCORD_FREED=0

SPOTIFY_FOUND=0
SPOTIFY_FREED=0

ZEN_FOUND=0
ZEN_FREED=0

EXTREME_FOUND=0
EXTREME_FREED=0

CURRENT_CATEGORY=""

###############################################################################
# BANNER / HELP
###############################################################################

banner() {
	# Purple -> cyan gradient
	local G1="\033[38;5;129m"
	local G2="\033[38;5;135m"
	local G3="\033[38;5;141m"
	local G4="\033[38;5;147m"
	local G5="\033[38;5;153m"
	local G6="\033[38;5;159m"
	local DIM="\033[2m"

	#        M         A       G       I       C       _     C       L       E       A       N       E       R
	local r1=("██▄ ▄██" "▄▀▀▀▄" "▄▀▀▀▀" "▀▀█▀▀" "▄▀▀▀▀" "  " "▄▀▀▀▀" "█    " "█▀▀▀▀" "▄▀▀▀▄" "█▄  █" "█▀▀▀▀" "█▀▀▀▄")
	local r2=("█ ▀█▀ █" "█▀▀▀█" "█  ▀█" "  █  " "█    " "  " "█    " "█    " "█▀▀▀ " "█▀▀▀█" "█ ▀▄█" "█▀▀▀ " "█▀▀█▀")
	local r3=("█     █" "█   █" "▀▄▄▄▀" "▄▄█▄▄" "▀▄▄▄▄" "  " "▀▄▄▄▄" "█▄▄▄▄" "█▄▄▄▄" "█   █" "█   █" "█▄▄▄▄" "█  ▀▄")

	local colors=("$G1" "$G2" "$G3" "$G4" "$G5" "$G6")
	local subtitle="✦ Disk-space sorcery for 1337 Ubuntu PCs ✦"
	local credits="Made by Bilal Rouane · 42 intra: brouane"
	local l1="" l2="" l3="" c i

	for i in "${!r1[@]}"; do
		c="${colors[i * ${#colors[@]} / ${#r1[@]}]}"
		l1+="${c}${r1[i]} "
		l2+="${c}${r2[i]} "
		l3+="${c}${r3[i]} "
	done

	echo
	printf "  %b\n" "${C_BOLD}${l1}${C_RESET}"
	printf "  %b\n" "${C_BOLD}${l2}${C_RESET}"
	printf "  %b\n" "${C_BOLD}${l3}${C_RESET}"
	echo
	printf "  %b\n" "${G6}${C_BOLD}${subtitle}${C_RESET}"
	printf "  %b\n" "${DIM}${credits}${C_RESET}"
	echo

	if [ "$DRY_RUN" -eq 1 ]; then
		printf "  %b\n\n" "${C_YELLOW}${C_BOLD}⚠ DRY-RUN mode: nothing will be deleted.${C_RESET}"
	fi
}

usage() {
	cat <<EOF
Usage: $SCRIPT_NAME [options]

Running with no arguments shows this help. Any option below runs on its
own; --only/-o and --wipe/-w each run just their own stage, everything
else (--safe-dry-run, --print, --yes) falls back to the full default clean
unless combined with --only/--wipe. --analyze/-a is read-only: used
by itself it just prints the report and exits, it never deletes anything.

Options:
  --safe, -s              Safe cleanup (recommended): removes temporary files,
                          caches, logs, Trash, Python cache (__pycache__,
                          .pyc, .pyo, pip/uv/pytest/mypy), VS Code caches,
                          browser caches (Chrome, Firefox, Brave, Discord,
                          Spotify, Zen), and miscellaneous application caches
                          (Obsidian, Prism Launcher, GNOME Extension Manager,
                          clipboard history). Never deletes history,
                          bookmarks, cookies, passwords, sessions, saved
                          logins, extensions, or extension settings.
  --safe-dry-run, -sdr    Show what would be deleted, do not delete
  --print, -p             Print each target before deleting it
  --analyze, -a           Report-only: show biggest space consumers in
                          your HOME, plus total/used/available disk space
                          on the filesystem behind \$HOME. Deletes
                          nothing. Combine with another option (e.g.
                          --analyze -s) to see the report before that
                          option runs.
  --only, -o CATEGORY     Run only one category:
                          general | python | vscode | chrome |
                          firefox | brave | discord | spotify | zen
  --wipe, -w              DANGEROUS. Fully wipe the entire local data
                          dir of one or more apps. See WIPE MODE
                          below. Always asks for confirmation per app
                          unless --yes is also given.
  --firefox               With --wipe: target Firefox
  --brave                 With --wipe: target Brave
  --discord               With --wipe: target Discord
  --spotify               With --wipe: target Spotify
  --zen                   With --wipe: target Zen Browser
  --chrome                With --wipe: target Chrome
  --vscode                With --wipe: target VS Code
  --yes, -y               Auto-confirm extreme-wipe prompts (see
                          WIPE MODE below)
  --help, -h              Show this help

APP CACHE CATEGORIES (safe, part of the default clean):
  firefox / brave / discord / spotify / zen each clean ONLY that app's
  CACHE folders (Flatpak installs under ~/.var/app) — things like Cache,
  Code Cache, GPUCache, Service Worker, shader caches. 
  But History, bookmarks, passwords, saved logins, sessions, preferences, and
  extension settings/storage are never touched by these. They run as
  part of the default clean, and can also be targeted directly:
    --only firefox / -o zen / etc.     clean just that one app's cache
    --safe-dry-run, -sdr                     show what would be cleaned,
                                       nothing deleted

WIPE MODE (--wipe, -w): DANGEROUS, OPT-IN, PER-APP
  This is the ONLY stage that deletes more than a cache: it removes an
  app's entire local data directory, including (for browsers) history,
  saved logins, passwords, active sessions, and (for VS Code) settings,
  keybindings, snippets, and installed extensions. It NEVER runs as
  part of the default clean and NEVER runs unless you pass --wipe/-w
  explicitly. It only ever deletes data — it never uninstalls the app
  itself; the app stays installed.

  Pick which app(s) to wipe with --firefox / --brave / --discord /
  --spotify / --zen / --chrome / --vscode. You can combine several. If
  --wipe is given with NONE of those app flags, it wipes ALL SEVEN
  supported apps (the old "purge everything" behavior) — so be careful
  with --wipe --yes on its own.

  Each targeted app shows its size and asks for an interactive y/N
  confirmation before it is wiped, unless --yes / -y is also given.
  --safe-dry-run / -sdr shows what wipe mode would remove, with no prompts
  and nothing deleted.

Default run (--safe / -s, or any standalone flag with no --only or
--wipe): general + python + vscode + chrome + firefox + brave +
discord + spotify + zen caches + misc caches (all safe).

Examples:
  $SCRIPT_NAME
  $SCRIPT_NAME --safe
  $SCRIPT_NAME --safe-dry-run
  $SCRIPT_NAME -sdr
  $SCRIPT_NAME --analyze
  $SCRIPT_NAME -a -s
  $SCRIPT_NAME --only vscode
  $SCRIPT_NAME -o zen
  $SCRIPT_NAME --wipe --brave
  $SCRIPT_NAME -w --discord
  $SCRIPT_NAME --wipe --brave --discord --zen
  $SCRIPT_NAME --wipe --chrome --vscode
  $SCRIPT_NAME --wipe --yes        # wipes ALL supported apps, no prompts
EOF
}

###############################################################################
# ARG PARSING
###############################################################################

if [ $# -eq 0 ]; then
	usage
	exit 0
fi

while [ $# -gt 0 ]; do
	case "$1" in
		--safe|-s)
			DEFAULT_RUN=1
			ANY_OPTION_SET=1
			;;
		--safe-dry-run|-sdr)
			DRY_RUN=1
			ANY_OPTION_SET=1
			;;
		--print|-p)
			PRINT_ITEMS=1
			ANY_OPTION_SET=1
			;;
		--analyze|-a)
			ANALYZE=1
			ANY_OPTION_SET=1
			;;
		--only|-o)
			shift
			if [ -z "$1" ]; then
				echo -e "${C_RED}--only requires a category${C_RESET}"
				usage
				exit 1
			fi
			ONLY_CATEGORY="$1"
			ANY_OPTION_SET=1
			;;
		--wipe|--extreem|-wipe|-extreem|-w)
			EXTREME=1
			EXTREME_ONLY=1
			ANY_OPTION_SET=1
			;;
		--firefox)
			EXTREME_FIREFOX=1
			ANY_OPTION_SET=1
			;;
		--brave)
			EXTREME_BRAVE=1
			ANY_OPTION_SET=1
			;;
		--discord)
			EXTREME_DISCORD=1
			ANY_OPTION_SET=1
			;;
		--spotify)
			EXTREME_SPOTIFY=1
			ANY_OPTION_SET=1
			;;
		--zen)
			EXTREME_ZEN=1
			ANY_OPTION_SET=1
			;;
		--chrome)
			EXTREME_CHROME=1
			ANY_OPTION_SET=1
			;;
		--vscode)
			EXTREME_VSCODE=1
			ANY_OPTION_SET=1
			;;
		--yes|-y)
			AUTO_YES=1
			ANY_OPTION_SET=1
			;;
		--help|-h)
			usage
			exit 0
			;;
		*)
			echo -e "${C_RED}Unknown option: $1${C_RESET}"
			usage
			exit 1
			;;
	esac
	shift
done

case "$ONLY_CATEGORY" in
	""|general|python|vscode|chrome|firefox|brave|discord|spotify|zen)
		;;
	*)
		echo -e "${C_RED}Invalid category for --only: $ONLY_CATEGORY${C_RESET}"
		usage
		exit 1
		;;
esac

# --firefox/--brave/--discord/--spotify/--zen/--chrome/--vscode only
# make sense alongside --wipe.
if [ "$EXTREME" -ne 1 ] && { [ "$EXTREME_FIREFOX" -eq 1 ] \
	|| [ "$EXTREME_BRAVE" -eq 1 ] || [ "$EXTREME_DISCORD" -eq 1 ] || [ "$EXTREME_SPOTIFY" -eq 1 ] \
	|| [ "$EXTREME_ZEN" -eq 1 ] || [ "$EXTREME_CHROME" -eq 1 ] || [ "$EXTREME_VSCODE" -eq 1 ]; }; then
	echo -e "${C_RED}--firefox/--brave/--discord/--spotify/--zen/--chrome/--vscode require --wipe${C_RESET}"
	usage
	exit 1
fi

# If --wipe was combined with --safe/-s, it's no longer an
# extreme-only run: run the full safe clean AND the extreme wipe.
if [ "$DEFAULT_RUN" -eq 1 ] && [ "$EXTREME" -eq 1 ]; then
	EXTREME_ONLY=0
fi

###############################################################################
# GENERIC HELPERS
###############################################################################

get_storage() {
	# Human-readable available space in $HOME's filesystem (for display).
	local storage
	storage=$(df -h "$HOME" | awk 'NR==2 {print $4}')
	[ -z "$storage" ] && storage="0B"
	echo "$storage"
}

get_storage_bytes() {
	# Available space in $HOME's filesystem, in bytes (for computing the delta).
	local bytes
	bytes=$(df -B1 "$HOME" | awk 'NR==2 {print $4}')
	[[ "$bytes" =~ ^[0-9]+$ ]] || bytes=0
	echo "$bytes"
}

print_disk_space() {
	# Human-readable total / used / available space for $HOME's
	# filesystem, plus the use percentage df already computes. Used by
	# --analyze to show overall device storage, not just per-folder sizes.
	local line
	line=$(df -h "$HOME" | awk 'NR==2 {print $2, $3, $4, $5}')
	[ -z "$line" ] && {
		echo -e "${C_YELLOW}Could not read disk space for \$HOME${C_RESET}"
		return 0
	}

	local total used avail pct
	read -r total used avail pct <<< "$line"

	echo -e "${C_CYAN}== Disk space (\$HOME filesystem) ==${C_RESET}"
	printf "  %-10s %s\n" "Total:"     "$total"
	printf "  %-10s %s\n" "Used:"      "$used ($pct)"
	printf "  %-10s %s\n" "Available:" "$avail"
	echo
}

human_size() {
	local bytes="$1"
	local units=("B" "K" "M" "G" "T")
	local i=0
	local value="$bytes"

	if ! [[ "$bytes" =~ ^[0-9]+$ ]]; then
		echo "0B"
		return
	fi

	while [ "$value" -ge 1024 ] 2>/dev/null && [ "$i" -lt 4 ]; do
		value=$((value / 1024))
		i=$((i + 1))
	done
	echo "${value}${units[$i]}"
}

path_size_bytes() {
	local path="$1"

	[ ! -e "$path" ] && {
		echo 0
		return
	}

	du -sb "$path" 2>/dev/null | awk '{print $1}'
}

print_item() {
	local label="$1"
	local bytes="$2"
	printf "  %-62s %10s\n" "$label" "$(human_size "$bytes")"
}

add_found_bytes() {
	local bytes="$1"

	TOTAL_FOUND_BYTES=$((TOTAL_FOUND_BYTES + bytes))

	case "$CURRENT_CATEGORY" in
		general)  GENERAL_FOUND=$((GENERAL_FOUND + bytes)) ;;
		python)   PYTHON_FOUND=$((PYTHON_FOUND + bytes)) ;;
		vscode)   VSCODE_FOUND=$((VSCODE_FOUND + bytes)) ;;
		chrome)   CHROME_FOUND=$((CHROME_FOUND + bytes)) ;;
		firefox)  FIREFOX_FOUND=$((FIREFOX_FOUND + bytes)) ;;
		brave)    BRAVE_FOUND=$((BRAVE_FOUND + bytes)) ;;
		discord)  DISCORD_FOUND=$((DISCORD_FOUND + bytes)) ;;
		spotify)  SPOTIFY_FOUND=$((SPOTIFY_FOUND + bytes)) ;;
		zen)      ZEN_FOUND=$((ZEN_FOUND + bytes)) ;;
		extreme)  EXTREME_FOUND=$((EXTREME_FOUND + bytes)) ;;
	esac
}

add_freed_bytes() {
	local bytes="$1"

	TOTAL_FREED_BYTES=$((TOTAL_FREED_BYTES + bytes))

	case "$CURRENT_CATEGORY" in
		general)  GENERAL_FREED=$((GENERAL_FREED + bytes)) ;;
		python)   PYTHON_FREED=$((PYTHON_FREED + bytes)) ;;
		vscode)   VSCODE_FREED=$((VSCODE_FREED + bytes)) ;;
		chrome)   CHROME_FREED=$((CHROME_FREED + bytes)) ;;
		firefox)  FIREFOX_FREED=$((FIREFOX_FREED + bytes)) ;;
		brave)    BRAVE_FREED=$((BRAVE_FREED + bytes)) ;;
		discord)  DISCORD_FREED=$((DISCORD_FREED + bytes)) ;;
		spotify)  SPOTIFY_FREED=$((SPOTIFY_FREED + bytes)) ;;
		zen)      ZEN_FREED=$((ZEN_FREED + bytes)) ;;
		extreme)  EXTREME_FREED=$((EXTREME_FREED + bytes)) ;;
	esac
}

remove_path() {
	local path="$1"
	local label="$2"
	local bytes

	[ -z "$path" ] && return 0
	[ ! -e "$path" ] && return 0

	bytes=$(path_size_bytes "$path")
	[ -z "$bytes" ] && bytes=0
	[ "$bytes" -eq 0 ] && return 0

	TOTAL_TARGETS=$((TOTAL_TARGETS + 1))
	add_found_bytes "$bytes"

	if [ "$PRINT_ITEMS" -eq 1 ] || [ "$DRY_RUN" -eq 1 ]; then
		print_item "$label" "$bytes"
	fi

	if [ "$DRY_RUN" -eq 1 ]; then
		return 0
	fi

	/bin/rm -rf -- "$path" 2>/dev/null
	add_freed_bytes "$bytes"
	return 0
}

remove_glob() {
	local label="$1"
	shift
	local path

	for path in "$@"; do
		remove_path "$path" "$label: $path"
	done
}

remove_literal_dir_contents() {
	# Remove only the contents of a directory, not the directory itself.
	local dir="$1"
	local label="$2"

	[ ! -d "$dir" ] && return 0
	remove_glob "$label" "$dir"/*
}

confirm_prompt() {
	local prompt="$1"
	local answer

	if [ "$AUTO_YES" -eq 1 ] || [ "$DRY_RUN" -eq 1 ]; then
		return 0
	fi

	printf "%s [y/N] " "$prompt"
	read -r answer

	case "$answer" in
		y|Y|yes|YES)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

extreme_wipe_app_dir() {
	local app_name="$1"
	local app_path="$2"
	local bytes

	[ ! -e "$app_path" ] && return 0

	bytes=$(path_size_bytes "$app_path")
	[ -z "$bytes" ] && bytes=0
	[ "$bytes" -eq 0 ] && return 0

	echo -e "${C_RED}\n[WIPE] About to fully wipe ${app_name} (history, logins, sessions, everything):${C_RESET}"
	echo "  $app_path"
	echo "  Size: $(human_size "$bytes")"

	if ! confirm_prompt "Continue?"; then
		echo "  skipped ${app_name}"
		return 0
	fi

	TOTAL_TARGETS=$((TOTAL_TARGETS + 1))
	add_found_bytes "$bytes"

	if [ "$PRINT_ITEMS" -eq 1 ] || [ "$DRY_RUN" -eq 1 ]; then
		print_item "WIPE $app_name" "$bytes"
	fi

	if [ "$DRY_RUN" -eq 1 ]; then
		return 0
	fi

	/bin/rm -rf -- "$app_path" 2>/dev/null
	add_freed_bytes "$bytes"
}

###############################################################################
# ANALYZE MODE
###############################################################################

analyze_section() {
	local title="$1"
	local target="$2"

	[ ! -e "$target" ] && return 0

	echo -e "${C_CYAN}== $title ==${C_RESET}"
	du -sh "$target"/* 2>/dev/null | sort -hr | head -30
	echo
}

run_analyze() {
	echo -e "${C_BLUE}Analyzing biggest space consumers under $HOME ...${C_RESET}\n"

	print_disk_space

	analyze_section "~/.var/app" "$HOME/.var/app"
	analyze_section "~/.cache" "$HOME/.cache"
	analyze_section "~/.config" "$HOME/.config"
	analyze_section "~/.local/share" "$HOME/.local/share"

	echo -e "${C_CYAN}== Top items in \$HOME ==${C_RESET}"
	du -sh "$HOME"/* "$HOME"/.* 2>/dev/null | sort -hr | head -40
	echo
}

