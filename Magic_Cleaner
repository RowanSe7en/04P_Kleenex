	[ "$DEFAULT_CACHE_BRAVE" -eq 1 ]   && clean_brave
	[ "$DEFAULT_CACHE_DISCORD" -eq 1 ] && clean_discord
	[ "$DEFAULT_CACHE_SPOTIFY" -eq 1 ] && clean_spotify
	[ "$DEFAULT_CACHE_ZEN" -eq 1 ]     && clean_zen
}

run_extreme() {
	clean_extreme
}

###############################################################################
# SUMMARY
###############################################################################

print_summary_line() {
	local name="$1"
	local found="$2"
	local freed="$3"

	if [ "$DRY_RUN" -eq 1 ]; then
		printf "  %-12s found: %8s   would free: %8s\n" \
			"$name" "$(human_size "$found")" "$(human_size "$found")"
	else
		printf "  %-12s found: %8s   freed:      %8s\n" \
			"$name" "$(human_size "$found")" "$(human_size "$freed")"
	fi
}

print_summary() {
	echo
	echo -e "${C_GREEN}-- Summary --${C_RESET}"
	echo "Targets touched: $TOTAL_TARGETS"
	echo

	print_summary_line "general"  "$GENERAL_FOUND"  "$GENERAL_FREED"
	print_summary_line "python"   "$PYTHON_FOUND"   "$PYTHON_FREED"
	print_summary_line "vscode"   "$VSCODE_FOUND"   "$VSCODE_FREED"
	print_summary_line "chrome"   "$CHROME_FOUND"   "$CHROME_FREED"
	print_summary_line "firefox"  "$FIREFOX_FOUND"  "$FIREFOX_FREED"
	print_summary_line "brave"    "$BRAVE_FOUND"    "$BRAVE_FREED"
	print_summary_line "discord"  "$DISCORD_FOUND"  "$DISCORD_FREED"
	print_summary_line "spotify"  "$SPOTIFY_FOUND"  "$SPOTIFY_FREED"
	print_summary_line "zen"      "$ZEN_FOUND"      "$ZEN_FREED"
	print_summary_line "extreme"  "$EXTREME_FOUND"  "$EXTREME_FREED"

	echo
	if [ "$DRY_RUN" -eq 1 ]; then
		echo "Total found : $(human_size "$TOTAL_FOUND_BYTES")"
		echo "Would free  : $(human_size "$TOTAL_FOUND_BYTES")"
	else
		echo "Total found : $(human_size "$TOTAL_FOUND_BYTES")"
		echo "Freed       : $(human_size "$TOTAL_FREED_BYTES")"
	fi
}

###############################################################################
# MAIN
###############################################################################

banner

if [ "$ANALYZE" -eq 1 ]; then
	run_analyze
fi

if [ "$ANY_OPTION_SET" -ne 1 ]; then
	echo -e "${C_YELLOW}No action specified. Use --safe/-s to run the full clean, or --help for options.${C_RESET}"
	exit 0
fi

# --analyze is a read-only report. If it's the only thing requested,
# stop here: never delete anything just because --analyze was passed.
if [ "$ANALYZE" -eq 1 ] && [ -z "$ONLY_CATEGORY" ] \
	&& [ "$DEFAULT_RUN" -ne 1 ] && [ "$DRY_RUN" -ne 1 ] && [ "$PRINT_ITEMS" -ne 1 ] \
	&& [ "$AUTO_YES" -ne 1 ] && [ "$EXTREME" -ne 1 ]; then
	exit 0
fi

before_storage="$(get_storage)"
before_storage_bytes="$(get_storage_bytes)"
echo -e "${C_YELLOW}\n -- Available Storage Before Cleaning : || ${before_storage} || --${C_RESET}"
echo -e "${C_RED}\n -- Cleaning ...\n${C_RESET}"

if [ -n "$ONLY_CATEGORY" ]; then
	run_only_category
elif [ "$EXTREME_ONLY" -eq 1 ]; then
	# --wipe on its own (no --safe/-s): run ONLY the extreme wipe,
	# nothing else gets touched.
	run_extreme
elif [ "$EXTREME" -eq 1 ]; then
	# --wipe combined with --safe/-s: run the full safe clean,
	# then also run the extreme wipe.
	run_default_clean
	run_extreme
else
	run_default_clean
fi

after_storage="$(get_storage)"
after_storage_bytes="$(get_storage_bytes)"
storage_delta_bytes=$((after_storage_bytes - before_storage_bytes))

print_summary

if [ "$DRY_RUN" -eq 1 ]; then
	echo -e "${C_YELLOW}\n -- DRY RUN complete. No files were deleted. --${C_RESET}"
else
	echo -e "${C_GREEN}\n -- Available Storage After Cleaning : || ${after_storage} || --${C_RESET}"
	if [ "$storage_delta_bytes" -ge 0 ]; then
		echo -e "${C_GREEN} -- Storage Freed (disk delta)       : || $(human_size "$storage_delta_bytes") || --${C_RESET}"
	else
		echo -e "${C_YELLOW} -- Storage Freed (disk delta)       : || disk usage grew by $(human_size "$((storage_delta_bytes * -1))") during the run, see Summary above --${C_RESET}"
	fi
fi

echo
