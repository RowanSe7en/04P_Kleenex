clean_general() {
	CURRENT_CATEGORY="general"
	echo -e "${C_ORANGE}-- [general] 42 / trash / cache / tmp / misc app caches --${C_RESET}"

	# 42 / shell leftovers
	remove_glob "42 cache" "$HOME"/.42*
	remove_glob "zcompdump" "$HOME"/.zcompdump*

	# Trash
	remove_glob "trash files" "$HOME"/.local/share/Trash/files/*
	remove_glob "trash info" "$HOME"/.local/share/Trash/info/*

	# General cache
	remove_glob "general cache" "$HOME"/.cache/*

	# Thumbnails
	remove_glob "thumbnails" "$HOME"/.cache/thumbnails/*
	remove_glob "old thumbnails" "$HOME"/.thumbnails/*

	# Desktop junk
	remove_glob ".DS_Store" "$HOME"/Desktop/**/*/.DS_Store
	remove_glob "Piscine Rules videos" "$HOME"/Desktop/Piscine\ Rules\ *.mp4
	remove_glob "PLAY_ME.webloc" "$HOME"/Desktop/PLAY_ME.webloc

	# Obsidian (cache/render junk only, vault content untouched)
	remove_glob "obsidian Cache" "$HOME"/.config/obsidian/Cache/*
	remove_glob "obsidian Code Cache" "$HOME"/.config/obsidian/Code\ Cache/*
	remove_glob "obsidian GPUCache" "$HOME"/.config/obsidian/GPUCache/*
	remove_glob "obsidian DawnGraphiteCache" "$HOME"/.config/obsidian/DawnGraphiteCache/*
	remove_glob "obsidian DawnWebGPUCache" "$HOME"/.config/obsidian/DawnWebGPUCache/*
	remove_glob "obsidian Shared Dictionary cache" "$HOME"/.config/obsidian/Shared\ Dictionary/cache/*

	# Prism Launcher (Minecraft launcher cache/logs, instances untouched)
	remove_glob "PrismLauncher cache" "$HOME"/.local/share/PrismLauncher/cache/*
	remove_glob "PrismLauncher logs" "$HOME"/.local/share/PrismLauncher/logs/*

	# GNOME Extension Manager
	remove_glob "ExtensionManager cache" "$HOME"/.var/app/com.mattjakeman.ExtensionManager/cache/*

	# Clipboard history
	remove_glob "clipboard history cache" "$HOME"/.cache/clipboard-history@alexsaveau.dev/*

	# Stray log files anywhere under HOME (safe: logs are disposable) —
	# EXCEPT inside any app's config/ tree (~/.config/* and every
	# ~/.var/app/*/config/*). Several storage backends (LevelDB, used by
	# Chrome's "Extension State", "Local Extension Settings", IndexedDB,
	# Local Storage, and similar stores in other Electron/Chromium apps)
	# name their live, uncommitted data files "*.log" — that is NOT a
	# debug log, and deleting it corrupts/resets the database (this is
	# what was silently resetting extension settings before). Real
	# disposable *.log files (build output, app logs, project dirs) are
	# almost always outside these config trees, so this exclusion is
	# safe and broad rather than a narrow, easy-to-miss allowlist.
	find "$HOME" -type f -name "*.log" \
		-not -path "$HOME/.config/*" \
		-not -path "$HOME/.var/app/*/config/*" \
		-print0 2>/dev/null | \
		while IFS= read -r -d '' f; do remove_path "$f" "stray log"; done
	find "$HOME" -type f -name "LOG.old" \
		-not -path "$HOME/.config/*" \
		-not -path "$HOME/.var/app/*/config/*" \
		-print0 2>/dev/null | \
		while IFS= read -r -d '' f; do remove_path "$f" "LOG.old"; done

	# /tmp files owned by user
	# We enumerate both dry-run and real mode so stats are accurate.
	local p
	for p in /tmp/*; do
		[ ! -e "$p" ] && continue
		[ ! -O "$p" ] && continue
		remove_path "$p" "tmp: $p"
	done
}

clean_python() {
	CURRENT_CATEGORY="python"
	echo -e "${C_ORANGE}-- [python] package / dev caches --${C_RESET}"

	# pip / Python
	remove_glob "pip cache" "$HOME"/.cache/pip/*
	remove_glob "pip cache dir" "$HOME"/.cache/pip
	remove_glob "pip user cache" "$HOME"/.local/share/pip-cache/*
	remove_glob "pytest cache" "$HOME"/.cache/pytest/*
	remove_glob "mypy cache" "$HOME"/.cache/mypy/*
	remove_glob "ruff cache" "$HOME"/.cache/ruff/*
	remove_glob "uv cache" "$HOME"/.cache/uv/*

	# JS package manager caches
	remove_glob "npm cache" "$HOME"/.npm/_cacache/*
	remove_glob "yarn cache" "$HOME"/.yarn/cache/*
	remove_glob "pnpm cache" "$HOME"/.cache/pnpm/*
	remove_glob "pnpm store cache" "$HOME"/.local/share/pnpm/store/*

	# Rust / Ruby
	remove_glob "cargo registry cache" "$HOME"/.cargo/registry/cache/*
	remove_glob "cargo git cache" "$HOME"/.cargo/git/db/*
	remove_glob "gem cache" "$HOME"/.gem/ruby/*/cache/*

	# Optional safe Python project junk:
	# remove per-project __pycache__ and .pytest_cache only under HOME,
	# but avoid .venv directories entirely.
	#
	# If you want this disabled, remove this block.
	while IFS= read -r -d '' d; do
		remove_path "$d" "python __pycache__"
	done < <(find "$HOME" \
		-type d \
		-name "__pycache__" \
		-not -path "*/.venv/*" \
		-not -path "$HOME/.cache/*" \
		-print0 2>/dev/null)

	while IFS= read -r -d '' d; do
		remove_path "$d" "python .pytest_cache"
	done < <(find "$HOME" \
		-type d \
		-name ".pytest_cache" \
		-not -path "*/.venv/*" \
		-print0 2>/dev/null)

	# Stray compiled Python files (.pyc/.pyo) anywhere under HOME, outside
	# .venv. Safe: these are regenerated automatically by the interpreter.
	find "$HOME" -type f -name "*.pyc" -not -path "*/.venv/*" -print0 2>/dev/null | \
		while IFS= read -r -d '' f; do remove_path "$f" "python .pyc"; done
	find "$HOME" -type f -name "*.pyo" -not -path "*/.venv/*" -print0 2>/dev/null | \
		while IFS= read -r -d '' f; do remove_path "$f" "python .pyo"; done
}

clean_vscode() {
	local base="$HOME/.var/app/com.visualstudio.code"

	[ ! -d "$base" ] && return 0

	CURRENT_CATEGORY="vscode"
	echo -e "${C_ORANGE}-- [vscode] VS Code Flatpak cleanup --${C_RESET}"

	# Flatpak cache
	remove_literal_dir_contents "$base/cache" "vscode cache"

	# Core caches
	remove_literal_dir_contents "$base/config/Code/Cache" "vscode code cache"
	remove_literal_dir_contents "$base/config/Code/CachedData" "vscode cached data"
	remove_literal_dir_contents "$base/config/Code/CachedProfilesData" "vscode cached profiles data"
	remove_literal_dir_contents "$base/config/Code/GPUCache" "vscode gpu cache"
	remove_literal_dir_contents "$base/config/Code/logs" "vscode logs"
	remove_literal_dir_contents "$base/config/Code/Crashpad" "vscode crashpad"

	# Only the two cache subdirs of Service Worker/ — never the whole
	# folder. Service Worker/ServiceWorkerDatabase holds registration
	# metadata for installed service workers (webview/extension-hosted
	# pages can register these); wiping the parent folder can make
	# extension webviews look broken/reset until reloaded.
	remove_literal_dir_contents "$base/config/Code/Service Worker/CacheStorage" "vscode service worker cache storage"
	remove_literal_dir_contents "$base/config/Code/Service Worker/ScriptCache" "vscode service worker script cache"

	# NOTE: Local Storage/, Session Storage/, and WebStorage/
	# intentionally NOT cleaned. Extension webviews can persist real
	# settings/state there via the standard web storage APIs — not pure
	# cache — so they're left alone, same policy as Chrome/Brave.

	remove_literal_dir_contents "$base/config/Code/DawnWebGPUCache" "vscode dawn webgpu cache"
	remove_literal_dir_contents "$base/config/Code/DawnGraphiteCache" "vscode dawn graphite cache"
	remove_literal_dir_contents "$base/config/Code/Shared Dictionary/cache" "vscode shared dictionary cache"

	# Heavy real target on your machine
	remove_literal_dir_contents \
		"$base/config/Code/CachedExtensionVSIXs" \
		"vscode CachedExtensionVSIXs"

	# Medium cleanup rule: remove history, keep settings/keybindings/snippets
	remove_literal_dir_contents \
		"$base/config/Code/User/History" \
		"vscode user history"

	remove_literal_dir_contents \
		"$base/config/Code/User/workspaceStorage" \
		"vscode workspaceStorage"
}

clean_chrome_profile() {
	local profile="$1"

	[ ! -d "$profile" ] && return 0

	# Only the two cache subdirectories of Service Worker/ are touched.
	# Service Worker/ServiceWorkerDatabase (NOT touched) holds the
	# registration metadata for every installed service worker, including
	# every Manifest V3 extension's background service worker. Deleting
	# the whole Service Worker/ folder (as this used to do) wipes that
	# registry and can make extensions look "reset" until reloaded.
	remove_literal_dir_contents "$profile/Service Worker/CacheStorage" "chrome service worker cache storage"
	remove_literal_dir_contents "$profile/Service Worker/ScriptCache" "chrome service worker script cache"
	remove_literal_dir_contents "$profile/GPUCache" "chrome gpu cache"
	remove_literal_dir_contents "$profile/DawnWebGPUCache" "chrome dawn webgpu cache"
	remove_literal_dir_contents "$profile/DawnGraphiteCache" "chrome dawn graphite cache"
	remove_literal_dir_contents "$profile/Code Cache" "chrome code cache"
	remove_literal_dir_contents "$profile/Cache" "chrome cache"
	remove_literal_dir_contents "$profile/Application Cache" "chrome application cache"
	remove_literal_dir_contents "$profile/blob_storage" "chrome blob storage"
	remove_literal_dir_contents "$profile/Shared Dictionary/cache" "chrome shared dictionary cache"

	# NOTE: File System/ intentionally NOT cleaned. It backs the
	# sandboxed Filesystem API and syncable filesystem, which extensions
	# and web apps can use to persist real data (not just cache); Chrome
	# itself never clears it proactively, so this script doesn't either.

	# NOTE: Extension State/, Local Extension Settings/, and Extension
	# Scripts/ (per profile, including every Profile */ variant) are
	# NEVER touched by this script. They hold real extension settings,
	# local storage, and content-script bookkeeping — not cache.
}

