	remove_literal_dir_contents "$base/cache" "zen flatpak cache"

	# Zen's Flatpak profile lives under .var/app/app.zen_browser.zen/.zen/
	# (about:profiles confirms the exact folder name per machine). Sweep
	# only cache/thumbnail dirs, same as Firefox — never places.sqlite,
	# logins.json, cookies, sessionstore, or zen-themes.json.
	for p in "$base"/.zen/*.default* "$base"/zen/*.default*; do
		[ -d "$p" ] || continue
		remove_literal_dir_contents "$p/cache2" "zen profile cache2"
		remove_literal_dir_contents "$p/startupCache" "zen startupCache"
		remove_literal_dir_contents "$p/shader-cache" "zen shader-cache"
		remove_literal_dir_contents "$p/thumbnails" "zen thumbnails"
