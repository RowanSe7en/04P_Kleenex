#!/bin/bash
# Magic_Cleaner
#
# Made for 1337 Ubuntu PCs
# Made by Bilal Rouane — 42 intra: brouane
#
# Policy:
# - General cleanup: yes
# - Python/dev caches: aggressive cache cleanup, but NEVER delete whole .venv
# - VS Code: medium cleanup
# - Chrome: cleanup only
# - Docker: untouched
# - Firefox / Brave / Discord / Spotify: purge-capable, with confirmation
#
# Running with no arguments shows help (same as --help / -h).
# Use --default / -d to run the full default clean:
#   general + python + vscode + chrome + purge
#
# Useful examples:
#   ./Magic_Cleaner
#   ./Magic_Cleaner --default
#   ./Magic_Cleaner -d --dry-run
#   ./Magic_Cleaner --analyze
#   ./Magic_Cleaner --only vscode
#   ./Magic_Cleaner --only purge
#   ./Magic_Cleaner -d --no-purge
#   ./Magic_Cleaner --purge-unused-apps --yes

###############################################################################
# SHELL / SAFETY
###############################################################################

set +e
shopt -s nullglob

###############################################################################
# CONFIG
###############################################################################

SCRIPT_NAME="$(basename "$0")"

# Default purge policy based on what you told me:
DEFAULT_PURGE_FIREFOX=1
DEFAULT_PURGE_BRAVE=1
DEFAULT_PURGE_DISCORD=1
DEFAULT_PURGE_SPOTIFY=1

###############################################################################
# FLAGS
###############################################################################

DRY_RUN=0
PRINT_ITEMS=0
ANALYZE=0
NO_PURGE=0
AUTO_YES=0
PURGE_ONLY=0
DEFAULT_RUN=0
ONLY_CATEGORY=""

